<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConanServerManager.Linux"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="850"
        Width="1300" Height="860" MinWidth="1000" MinHeight="700"
        x:Class="ConanServerManager.Linux.MainWindow"
        Title="Conan Enhanced Server Manager (Linux Fedora KDE)"
        Background="#0B0F19" Foreground="#F8FAFC">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>
        <Style Selector="TextBlock.cardValue">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.success">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#38BDF8"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
        
        <!-- ROW 0: HEADER & CONNECTION BAR -->
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,12" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Title & Platform Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚔️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Conan Enhanced Server Manager" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border Background="#1E1B4B" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="6" Margin="10,0,0,0" Padding="6,2">
                                <TextBlock Text="✨ v1.3.0" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                            </Border>
                            <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Margin="6,0,0,0" Padding="6,2">
                                <TextBlock Text="🐧 Linux Fedora KDE" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Remote Client for Windows Conan Exiles Dedicated Server Host" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connection Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <ComboBox x:Name="CmbDiscoveredServers" Width="200" VerticalAlignment="Center" PlaceholderText="Select / Discover Server..."/>
                    <Button x:Name="BtnScanLan" Content="🔍 Scan LAN" Classes="secondary" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtServerUrl" Text="http://127.0.0.1:8088" Width="180" VerticalAlignment="Center"/>
                    <Button x:Name="BtnConnect" Content="🔌 Connect" Classes="primary" VerticalAlignment="Center"/>
                    <Border x:Name="LedConnection" CornerRadius="12" Width="12" Height="12" Margin="4,0,0,0" VerticalAlignment="Center" Background="#EF4444"/>
                    <TextBlock x:Name="TxtConnectionStatus" Text="DISCONNECTED" FontSize="11" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: TOP METRICS DASHBOARD CARDS -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,12">
            <!-- Status Card -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="SERVER STATUS" Classes="cardTitle"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <Border x:Name="LedStatusBadge" CornerRadius="12" Width="12" Height="12" Background="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatusText" Text="STOPPED" FontSize="16" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtUptime" Text="Uptime: 00:00:00" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Hardware Card -->
            <Border Grid.Column="1" Classes="card" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="SERVER HARDWARE METRICS" Classes="cardTitle"/>
                    <TextBlock x:Name="TxtCpuRam" Text="CPU: 0.0% | RAM: 0 MB" Classes="cardValue"/>
                    <ProgressBar x:Name="ProgRam" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,6,0,0" Foreground="#38BDF8" Background="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Players Card -->
            <Border Grid.Column="2" Classes="card" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE PLAYERS" Classes="cardTitle"/>
                    <TextBlock x:Name="TxtPlayerCount" Text="0 / 40 Online" Classes="cardValue"/>
                    <TextBlock x:Name="TxtServerNameDisplay" Text="Conan Dedicated Server" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Workshop Mods Card -->
            <Border Grid.Column="3" Classes="card" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="STEAM WORKSHOP MODS" Classes="cardTitle"/>
                    <TextBlock x:Name="TxtModsSummary" Text="0 Installed Mods" Classes="cardValue"/>
                    <TextBlock x:Name="TxtPreDownloadStatus" Text="All Ready on Disk" FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: ACTION CONTROLS & DOWNLOAD PROGRESS -->
        <Border Grid.Row="2" Classes="card" Margin="0,0,0,12" Padding="12,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnStartServer" Content="▶ Start Server" Classes="success" Padding="14,8"/>
                    <Button x:Name="BtnStopServer" Content="■ Stop Server" Classes="danger" Padding="14,8"/>
                    <Button x:Name="BtnRestartServer" Content="🔄 Clean Restart" Classes="primary" Padding="14,8"/>
                    <Button x:Name="BtnBackupServer" Content="💾 Trigger Hot Backup" Classes="secondary" Padding="14,8"/>
                </StackPanel>

                <!-- Download Progress Indicator (shown during update/predownload) -->
                <Grid Grid.Column="1" x:Name="PnlDownloadProgress" Margin="16,0" VerticalAlignment="Center" IsVisible="false">
                    <Grid RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,3">
                            <TextBlock x:Name="TxtDownloadProgress" Text="Downloading: 0% (0.0 MB/s)" FontSize="11" Foreground="#38BDF8"/>
                            <TextBlock x:Name="TxtDownloadEta" Text=" | ETA: --" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" x:Name="ProgDownload" Minimum="0" Maximum="100" Value="0" Height="6" Foreground="#10B981" Background="#0F172A"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnRefreshStatus" Content="🔄 Refresh Status" Classes="secondary" Padding="10,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 3: MULTI-TAB WORKSPACE -->
        <TabControl Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="12">
            
            <!-- TAB 1: LIVE SERVER LOGS -->
            <TabItem Header="📜 Live Server Console">
                <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
                    <Border Grid.Row="0" Background="#020617" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBox x:Name="TxtServerLogs" 
                                 FontFamily="Monospace, Consolas, Courier New" 
                                 FontSize="12" 
                                 Foreground="#34D399" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 IsReadOnly="true" 
                                 AcceptsReturn="true" 
                                 TextWrapping="NoWrap"/>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                        <CheckBox Grid.Column="0" x:Name="ChkAutoScroll" Content="Auto-Scroll Console" IsChecked="true" Foreground="#94A3B8" FontSize="12"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnClearLogs" Content="🧹 Clear View" Classes="secondary" Padding="10,5"/>
                            <Button x:Name="BtnCopyLogs" Content="📋 Copy All" Classes="secondary" Padding="10,5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: RCON TERMINAL -->
            <TabItem Header="⚡ RCON Terminal">
                <Grid RowDefinitions="*,Auto,Auto" Margin="0,10,0,0">
                    <!-- RCON Log Output -->
                    <Border Grid.Row="0" Background="#020617" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBox x:Name="TxtRconLogs" 
                                 FontFamily="Monospace, Consolas, Courier New" 
                                 FontSize="12" 
                                 Foreground="#38BDF8" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 IsReadOnly="true" 
                                 AcceptsReturn="true" 
                                 TextWrapping="Wrap"/>
                    </Border>

                    <!-- Quick RCON Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button x:Name="BtnRconSave" Content="💾 save (Force World Flush)" Classes="secondary" Padding="10,6"/>
                        <Button x:Name="BtnRconListPlayers" Content="👥 listplayers" Classes="secondary" Padding="10,6"/>
                        <Button x:Name="BtnRconBroadcast" Content="📢 broadcast (Announcement)" Classes="secondary" Padding="10,6"/>
                        <Button x:Name="BtnRconKick" Content="🚪 kick Player" Classes="secondary" Padding="10,6"/>
                    </StackPanel>

                    <!-- Command Prompt Input -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <TextBox Grid.Column="0" x:Name="TxtRconCommand" PlaceholderText="Enter RCON command (e.g. broadcast Hello World or listplayers)..." Margin="0,0,8,0"/>
                        <Button Grid.Column="1" x:Name="BtnSendRcon" Content="▶ Execute Command" Classes="primary" Padding="16,8"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: WORKSHOP MODS -->
            <TabItem Header="🧩 Steam Workshop Mods">
                <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
                    <!-- Mod Actions Toolbar -->
                    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnAddMod" Content="➕ Add Mod ID" Classes="success" Padding="12,6"/>
                                <Button x:Name="BtnPreDownloadMod" Content="📥 Pre-Download / Validate on Server" Classes="primary" Padding="12,6"/>
                                <Button x:Name="BtnRemoveMod" Content="🗑️ Remove Mod" Classes="danger" Padding="12,6"/>
                                <Button x:Name="BtnRefreshMods" Content="🔄 Refresh Mods" Classes="secondary" Padding="12,6"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="BtnOpenWorkshopBrowser" Content="🌐 Open Steam Workshop (Browser)" Classes="secondary" Padding="12,6"/>
                        </Grid>
                    </Border>

                    <!-- Mod Items List -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="6">
                        <ListBox x:Name="LstMods" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:ModItemModel">
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="🧩" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock Text="{Binding Id, StringFormat='Mod ID: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding PakPath}" FontSize="10" Foreground="#64748B" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: SERVER INI EDITOR -->
            <TabItem Header="📝 Server INI Files">
                <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Select Configuration File:" VerticalAlignment="Center" FontSize="12" Foreground="#94A3B8"/>
                            <ComboBox x:Name="CmbIniFiles" Width="200" SelectedIndex="0">
                                <ComboBoxItem Content="ServerSettings.ini"/>
                                <ComboBoxItem Content="Engine.ini"/>
                                <ComboBoxItem Content="Game.ini"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnFetchIni" Content="📥 Fetch from Server" Classes="secondary" Padding="12,6"/>
                            <Button x:Name="BtnSaveIni" Content="💾 Save to Server" Classes="primary" Padding="12,6"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#020617" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBox x:Name="TxtIniContent" 
                                 FontFamily="Monospace, Consolas, Courier New" 
                                 FontSize="12" 
                                 Foreground="#E2E8F0" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 AcceptsReturn="true" 
                                 TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: REMOTE CONFIGURATION -->
            <TabItem Header="⚙️ Remote Settings">
                <ScrollViewer Margin="0,10,0,0">
                    <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="SERVER IDENTITY &amp; PASSWORDS" Classes="cardTitle"/>
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Server Name:" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtConfigServerName" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Server Password:" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtConfigServerPassword" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Admin Password:" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtConfigAdminPassword" PasswordChar="•" Margin="0,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="NETWORK &amp; PORTS" Classes="cardTitle"/>
                                <Grid ColumnDefinitions="140,*,140,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Port:" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtConfigGamePort" Margin="0,2,8,2"/>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Raw UDP Port:" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtConfigRawPort" Margin="0,2,0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Query Port:" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtConfigQueryPort" Margin="0,2,8,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="RCON Port:" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtConfigRconPort" Margin="0,2,0,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnReloadConfig" Content="📥 Fetch Remote Config" Classes="secondary" Padding="16,8"/>
                            <Button x:Name="BtnSaveConfig" Content="💾 Push Configuration to Server" Classes="primary" Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ROW 4: STATUS FOOTER -->
        <Border Grid.Row="4" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TxtFooterStatus" Text="Ready. Connected to Linux Fedora KDE Avalonia Engine." FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Conan Server Manager v1.3.0 | Linux Native X11/Wayland" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
