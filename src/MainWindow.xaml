<Window x:Class="ConanServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Conan Exiles Dedicated Server Manager &amp; Remote Console (C# Native Engine)" Height="960" Width="1400"
        Icon="app.ico"
        Background="#0F172A" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Glassmorphic compact panel style -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#E0E7FF"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#818CF8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Rich Dark Glassmorphic ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MaxWidth" Value="440"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="LineHeight" Value="17"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="StackPanel">
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>

        <Style x:Key="FormCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,1,4,1"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="*"/>    <!-- 1: Top-Level Workspace Tabs (Tab 1: Main Server Dashboard | Tab 2: Gameplay & ServerSettings.ini) -->
            <RowDefinition Height="Auto"/> <!-- 2: RCON Input Bar -->
            <RowDefinition Height="Auto"/> <!-- 3: System Metrics & Uptime Status Bar -->
        </Grid.RowDefinitions>

        <!-- Header & App Update Banner -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource GlassPanel}" Margin="2,2,2,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="app.png" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAppHeaderTitle" Text="Conan Enhanced Server Manager v1.5.1" Style="{StaticResource HeaderTitle}"/>
                            <Border CornerRadius="8" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAppHeaderVersionBadge" Text="🚀 v1.5.1" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtServerPathInfo" Text="Mode: Local Server Host | Embedded Web Console: http://0.0.0.0:8088" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Full-Page Workshop Browser Button -->
                        <Button Content="🌐 Steam Workshop Browser" Style="{StaticResource BtnSuccess}" Click="BtnOpenWorkshopBrowser_Click" Margin="0,0,10,0" Padding="12,5" FontWeight="Bold" ToolTip="Open full-page Steam Workshop browser to search and install mods"/>

                        <!-- Steam Master Server Visibility LED & Status -->
                        <Border x:Name="BadgeSteamVisibility" CornerRadius="12" Padding="10,3" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Steam Visibility: Live check via Steam A2S Query protocol on Query Port (27015).">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="LedSteamVisibility" Width="8" Height="8" Fill="#64748B" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtSteamVisibility" Text="STEAM: OFFLINE" Foreground="#94A3B8" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Process Status Badge -->
                        <Border x:Name="StatusBadge" CornerRadius="12" Padding="10,3" Background="#26EF4444" BorderBrush="#4DEF4444" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="STOPPED" Foreground="#F87171" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Crash Loop Protection Alert Banner -->
            <Border x:Name="PnlCrashLoopAlert" Style="{StaticResource GlassPanel}" Margin="2,1,2,2" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1.5" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCrashLoopTitle" Text="CRASH LOOP DETECTED - AUTO-RESTART PAUSED" Foreground="#FCA5A5" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtCrashLoopDetails" Text="Server crashed repeatedly. Suspected culprit: Mod #123456" Foreground="#F87171" FontSize="10" Margin="20,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnDisableCrashMod" Content="🗑️ Disable Offending Mod &amp; Restart" Style="{StaticResource BtnDanger}" Click="BtnDisableCrashMod_Click" Padding="8,3" FontSize="10" FontWeight="Bold"/>
                    <Button Grid.Column="3" x:Name="BtnDismissCrashLoop" Content="✕ Dismiss" Style="{StaticResource BtnSecondary}" Click="BtnDismissCrashLoop_Click" Padding="6,2" FontSize="10"/>
                </Grid>
            </Border>

            <!-- Application Update Notification Banner -->
            <Border x:Name="PnlAppUpdateBanner" Style="{StaticResource GlassPanel}" Margin="2,1,2,2" Background="#1E1B4B" BorderBrush="#6366F1" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtAppUpdateNotice" Text="New version available: v1.0.1" Foreground="#C7D2FE" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnApplyAppUpdate" Content="📥 Download &amp; Update Now" Style="{StaticResource BtnPrimary}" Click="BtnApplyAppUpdate_Click" Padding="8,3" FontSize="10"/>
                    <Button Grid.Column="3" x:Name="BtnDismissUpdateBanner" Content="✕" Style="{StaticResource BtnSecondary}" Click="BtnDismissUpdateBanner_Click" Padding="6,2" FontSize="10"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Row 1: Top-Level Workspace Tabs (Tab 1: Main Server Dashboard | Tab 2: Full-Window Gameplay & ServerSettings.ini Configurator | Tab 3: Live World Map & Pippi Admin) -->
        <TabControl x:Name="RootWorkspaceTabControl" Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Margin="2,2,2,2" SelectionChanged="RootWorkspaceTabControl_SelectionChanged">
            <!-- TOP-LEVEL TAB 1: MAIN SERVER DASHBOARD -->
            <TabItem Padding="14,5" FontSize="12" FontWeight="Bold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥️ Main Server Dashboard" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Config Cards Grid (Compact 4 Columns) -->
                        <RowDefinition Height="Auto"/> <!-- 1: Action Control Buttons Bar -->
                        <RowDefinition Height="*"/>    <!-- 2: Main Multi-Tab Log & Mod Panel -->
                    </Grid.RowDefinitions>

                    <!-- Top Configuration Grid (Compact 4 Columns Layout) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Mode, Server Identity & Rules -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <TextBlock Text="Connection Mode" Style="{StaticResource SectionHeading}"/>
                                    <WrapPanel Margin="0,1,0,3">
                                        <RadioButton x:Name="RadLocalMode" Content="Local Host" Foreground="#E2E8F0" FontWeight="Bold" IsChecked="True" Checked="RadMode_Checked" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Local Host Mode: Directly manages a Conan Exiles Dedicated Server installed on this machine and hosts the HTTP/WebSocket Remote API on the Web API Port."/>
                                        <RadioButton x:Name="RadRemoteMode" Content="Remote Client" Foreground="#E2E8F0" FontWeight="Bold" Checked="RadMode_Checked" VerticalAlignment="Center" ToolTip="Remote Client Mode: Connects over LAN/Internet to another machine running Conan Server Manager on its Web API Port (default 8088)."/>
                                    </WrapPanel>

                                    <!-- Remote Server Dropdown Selection & LAN/VM Scan -->
                                    <Grid Margin="0,1,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CmbRemoteServers" Style="{StaticResource FormCombo}" DisplayMemberPath="DisplayText" SelectionChanged="CmbRemoteServers_SelectionChanged" ToolTip="Select a target server (Localhost, Discovered on LAN/VM subnet, or Custom URL)."/>
                                        <Button Grid.Column="2" x:Name="BtnDiscoverServers" Content="🔍 Scan" Style="{StaticResource BtnSecondary}" Padding="6,1" FontSize="10" ToolTip="Scan local network &amp; VM subnets for active Conan Server Manager instances." Click="BtnDiscoverServers_Click"/>
                                    </Grid>

                                    <!-- Target Server URL & Connect Button -->
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TxtRemoteUrl" Style="{StaticResource FormInput}" Text="http://127.0.0.1:8088" ToolTip="Target Remote Server API URL (e.g. http://192.168.1.100:8088)."/>
                                        <Button Grid.Column="2" x:Name="BtnConnectRemote" Content="Connect" Style="{StaticResource BtnPrimary}" Padding="8,1" FontSize="10" ToolTip="Connect to the specified Remote Server Manager instance." Click="BtnConnectRemote_Click"/>
                                    </Grid>

                                    <StackPanel x:Name="PnlRemoteStatusIndicator" Orientation="Horizontal" Margin="0,3,0,0" Visibility="Collapsed">
                                        <Ellipse x:Name="LedRemoteConnection" Width="8" Height="8" Fill="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="Remote Connection Status Indicator"/>
                                        <TextBlock x:Name="TxtRemoteStatusText" Text="Remote Status: STANDBY (Click Connect)" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <TextBlock Text="Server Identity &amp; Rules" Style="{StaticResource SectionHeading}"/>
                                    <StackPanel ToolTip="ServerName (Engine.ini / ServerSettings.ini)&#x0a;Summary: Public display name shown in the Conan Exiles in-game server browser and Steam server list.&#x0a;Hint: Avoid special symbols that may break command-line parsing; use letters, numbers, spaces, and brackets.">
                                        <TextBlock Text="Server Name" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtServerName" Style="{StaticResource FormInput}"/>
                                    </StackPanel>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" ToolTip="ServerPassword (ServerSettings.ini / Engine.ini)&#x0a;Summary: Password required for players to join the server.&#x0a;Options &amp; Hints:&#x0a;• Leave completely BLANK for a public (open) server&#x0a;• Enter a password to restrict access to invited players">
                                            <TextBlock Text="Server Password" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtServerPass" Style="{StaticResource FormInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="AdminPassword (ServerSettings.ini)&#x0a;Summary: Password used inside the game (Settings → Server Settings → Make Me Admin) to unlock the in-game Admin Panel, teleport, spawn items, and change rules live.&#x0a;Hint: Choose a strong password so regular players cannot grant themselves admin privileges.">
                                            <TextBlock Text="Admin Password" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtAdminPass" Style="{StaticResource FormInput}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" ToolTip="MaxPlayers ([/Script/Engine.GameSession] in Game.ini &amp; -MaxPlayers CLI)&#x0a;Summary: Maximum number of concurrent players allowed on the server at one time.&#x0a;Vanilla Default: 40&#x0a;Options &amp; Hints:&#x0a;• 10–20 = Small private / co-op server&#x0a;• 40 = Official standard capacity&#x0a;• 60–70 = High-population server (requires strong CPU)">
                                            <TextBlock Text="Max Players" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtMaxPlayers" Style="{StaticResource FormInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="NetServerMaxTickRate ([/Script/OnlineSubsystemUtils.IpNetDriver] in Engine.ini)&#x0a;Summary: Maximum server simulation updates (ticks / frames) per second.&#x0a;Vanilla Default: 30&#x0a;Options &amp; Hints:&#x0a;• 30 = Official default (balanced CPU usage)&#x0a;• 60 = Smoother NPC AI &amp; combat responsiveness (higher CPU load)">
                                            <TextBlock Text="Max Tick Rate" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtMaxTickRate" Style="{StaticResource FormInput}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" ToolTip="serverRegion (ServerSettings.ini)&#x0a;Summary: Geographic region tag displayed in the in-game server browser filter.&#x0a;Options:&#x0a;• 0 = Europe&#x0a;• 1 = America (East)&#x0a;• 2 = America (West)&#x0a;• 3 = Asia&#x0a;• 4 = Oceania&#x0a;• 5 = South America">
                                            <TextBlock Text="Server Region" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CmbRegion" Style="{StaticResource FormCombo}">
                                                <ComboBoxItem Content="0 - Europe" IsSelected="True"/>
                                                <ComboBoxItem Content="1 - America (East)"/>
                                                <ComboBoxItem Content="2 - America (West)"/>
                                                <ComboBoxItem Content="3 - Asia"/>
                                                <ComboBoxItem Content="4 - Oceania"/>
                                                <ComboBoxItem Content="5 - South America"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="Startup Map (First CLI argument to ConanSandboxServer.exe)&#x0a;Summary: Selects which map world the dedicated server loads on startup.&#x0a;Options &amp; Hints:&#x0a;• ConanSandbox (Merged Enhanced World) = Standard Conan Exiles Enhanced world (Exiled Lands + Isle of Siptah merged)&#x0a;• Savage Wilds = Popular Workshop mod map&#x0a;• Custom Map Path... = Enter any custom Workshop map asset path">
                                            <TextBlock Text="Startup Map" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CmbStartupMap" Style="{StaticResource FormCombo}" SelectionChanged="CmbStartupMap_SelectionChanged">
                                                <ComboBoxItem Content="ConanSandbox (Merged Enhanced World)" Tag="ConanSandbox (Merged Enhanced World)|/Game/Maps/ConanSandbox/ConanSandbox" IsSelected="True"/>
                                                <ComboBoxItem Content="Savage Wilds (Mod Map)" Tag="Savage Wilds|/Game/Mods/Savage_Wilds/Savage_Wilds"/>
                                                <ComboBoxItem Content="Custom Map Path..." Tag="CUSTOM"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox x:Name="TxtStartupMapPath" Style="{StaticResource FormInput}" Margin="0,2,0,0" Visibility="Collapsed" ToolTip="Custom Unreal Engine map asset path (e.g. /Game/Mods/MyMap/MyMap). Passed as the first startup argument to ConanSandboxServer.exe."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Column 1: Network, NIC Selection & Ports -->
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <TextBlock Text="Network Interface &amp; IP" Style="{StaticResource SectionHeading}"/>
                                    <StackPanel ToolTip="Network Adapter (NIC)&#x0a;Summary: Selects which physical or virtual network card's IPv4 address is used when Multihome binding is enabled.">
                                        <TextBlock Text="Network Adapter (NIC)" Style="{StaticResource FormLabel}"/>
                                        <ComboBox x:Name="CmbNetworkAdapter" Style="{StaticResource FormCombo}" SelectionChanged="CmbNetworkAdapter_SelectionChanged"/>
                                    </StackPanel>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" ToolTip="Public External IP&#x0a;Summary: Your router's public WAN IPv4 address detected automatically. Share this IP + Game Port with external friends for Direct Connect.">
                                            <TextBlock Text="Public External IP" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtExternalIp" Style="{StaticResource FormInput}" IsReadOnly="True" Background="#1E293B"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="Adapter MAC Address&#x0a;Summary: Hardware MAC address of the selected network interface (useful for setting a static DHCP reservation on your router).">
                                            <TextBlock Text="Adapter MAC" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtMacAddress" Style="{StaticResource FormInput}" IsReadOnly="True" Background="#1E293B"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="BtnCopyConnectionInfo" Content="📋 Copy Connection Info" Style="{StaticResource BtnSecondary}" Click="BtnCopyConnectionInfo_Click" Margin="0,3,0,0" ToolTip="Copy server Name, Direct Connect IP:Port, and Steam Query address to clipboard to share on Discord."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <TextBlock Text="Port Matrix &amp; Multihome" Style="{StaticResource SectionHeading}"/>
                                    <WrapPanel ToolTip="MULTIHOME (-MULTIHOME=&lt;IP&gt;)&#x0a;Summary: Forces the Unreal Engine server to bind specifically to the chosen local IPv4 address.&#x0a;Hint: Enable this if your PC has multiple network cards, VPN adapters, or VMware/Hyper-V switches.">
                                        <CheckBox x:Name="ChkUseMultihome" Content="Use Multihome" Style="{StaticResource FormCheck}"/>
                                        <TextBox x:Name="TxtMultihomeIp" Style="{StaticResource FormInput}" Width="90"/>
                                    </WrapPanel>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" ToolTip="Game Port (UDP)&#x0a;Summary: Primary UDP port used for all in-game player traffic and Direct Connect.&#x0a;Default: 7777 (UDP)&#x0a;Hint: Must be port-forwarded (UDP) on your router.">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="LedGamePort" Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Game Port Status (Green = Bound/Accessible, Red = Not Bound)"/>
                                                <TextBlock Text="Game Port (UDP)" Style="{StaticResource FormLabel}"/>
                                            </StackPanel>
                                            <TextBox x:Name="TxtGamePort" Style="{StaticResource FormInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="Peer / Raw UDP Port (GamePort + 1)&#x0a;Summary: Secondary UDP port required by Conan Exiles (always Game Port + 1).&#x0a;Default: 7778 (UDP)&#x0a;Hint: Forward UDP 7777–7778 together on your router.">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="LedRawPort" Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Raw UDP Port Status (Green = Bound/Accessible, Red = Not Bound)"/>
                                                <TextBlock Text="Peer Port (UDP)" Style="{StaticResource FormLabel}"/>
                                            </StackPanel>
                                            <TextBox x:Name="TxtRawPort" Style="{StaticResource FormInput}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" ToolTip="Steam Query Port (UDP)&#x0a;Summary: Used by the Steam Master Server and server browser to list your server, player count, and ping.&#x0a;Default: 27015 (UDP)&#x0a;Hint: Must be port-forwarded (UDP) for your server to appear in the public list.">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="LedQueryPort" Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Query Port Status (Green = Bound/Accessible, Red = Not Bound)"/>
                                                <TextBlock Text="Query (UDP)" Style="{StaticResource FormLabel}"/>
                                            </StackPanel>
                                            <TextBox x:Name="TxtQueryPort" Style="{StaticResource FormInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="RCON Port (TCP)&#x0a;Summary: Remote Console TCP port used by this manager to broadcast restart warnings, list online players, and run admin commands.&#x0a;Default: 25575 (TCP)">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="LedRconPort" Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="RCON Port Status (Green = Bound/Accessible, Red = Not Bound)"/>
                                                <TextBlock Text="RCON (TCP)" Style="{StaticResource FormLabel}"/>
                                            </StackPanel>
                                            <TextBox x:Name="TxtRconPort" Style="{StaticResource FormInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" ToolTip="Web API Port (TCP)&#x0a;Summary: HTTP &amp; WebSocket port for the embedded Web Console and Android Companion App.&#x0a;Default: 8088 (TCP)">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="LedWebPort" Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Web API Port Status (Green = Bound/Accessible, Red = Not Bound)"/>
                                                <TextBlock Text="Web API" Style="{StaticResource FormLabel}"/>
                                            </StackPanel>
                                            <TextBox x:Name="TxtWebPort" Style="{StaticResource FormInput}" Text="8088"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6" ToolTip="Live World Map Webpage Port (TCP)&#x0a;Summary: Dedicated HTTP server port hosting the interactive Live World Map &amp; Pippi Admin webpage showing player locations, clan bases, and warps.&#x0a;Default: 8089 (TCP)&#x0a;Hint: Open http://localhost:8089 or forward TCP 8089 on your router to share the live map in any browser.">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="LedLiveMapPort" Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Live Map Port Status (Green = Bound/Accessible, Red = Not Bound)"/>
                                                <TextBlock Text="Map Web" Style="{StaticResource FormLabel}"/>
                                            </StackPanel>
                                            <TextBox x:Name="TxtLiveMapPort" Style="{StaticResource FormInput}" Text="8089"/>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,2,0,0">
                                        <CheckBox x:Name="ChkRconEnable" Content="Enable RCON" Style="{StaticResource FormCheck}" IsChecked="True" ToolTip="RconEnabled (Game.ini)&#x0a;Summary: Enables Remote Console (RCON) support on the server.&#x0a;Hint: Keep enabled so the manager can send graceful shutdown warnings and fetch live player lists."/>
                                        <CheckBox x:Name="ChkBattlEye" Content="BattlEye" Style="{StaticResource FormCheck}" ToolTip="IsBattlEyeEnabled (ServerSettings.ini)&#x0a;Summary: Enables BattlEye anti-cheat protection.&#x0a;Hint: Leave unchecked on modded private servers for faster loading and fewer client kicks."/>
                                        <CheckBox x:Name="ChkVAC" Content="VAC" Style="{StaticResource FormCheck}" ToolTip="IsVACEnabled (ServerSettings.ini)&#x0a;Summary: Enables Valve Anti-Cheat (VAC) verification for connecting Steam accounts."/>
                                    </WrapPanel>
                                    <StackPanel ToolTip="RconPassword (Game.ini)&#x0a;Summary: Secret password authenticating RCON TCP sessions between this manager and the Conan server.">
                                        <TextBlock Text="RCON Password" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtRconPass" Style="{StaticResource FormInput}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Column 2: Automatic Restarts & Countdown Warning Sequence -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <TextBlock Text="Automatic Restart Schedule" Style="{StaticResource SectionHeading}"/>
                                    <WrapPanel ToolTip="Daily Scheduled Restart&#x0a;Summary: Automatically triggers a graceful warning countdown and restarts the server at the specified 24-hour time (HH:mm:ss).&#x0a;Default: 06:00:00 (6:00 AM)">
                                        <CheckBox x:Name="ChkDailyRestart" Content="Restart Daily At:" Style="{StaticResource FormCheck}"/>
                                        <TextBox x:Name="TxtDailyRestartTime" Style="{StaticResource FormInput}" Text="06:00:00" Width="65"/>
                                    </WrapPanel>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" ToolTip="Minimum Uptime (HH:mm:ss)&#x0a;Summary: Prevents a scheduled daily restart from triggering if the server was already manually restarted very recently (within this duration).">
                                            <TextBlock Text="Min Uptime" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtMinUptime" Style="{StaticResource FormInput}" Text="02:00:00"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="Restarts Per Day&#x0a;Summary: Number of evenly spaced automatic restarts per 24-hour cycle (1 = once daily at the scheduled time, 2 = every 12 hours, 4 = every 6 hours).">
                                            <TextBlock Text="Restarts / Day" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtRestartsPerDay" Style="{StaticResource FormInput}" Text="1"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <TextBlock Text="Shutdown Warning Sequence (RCON)" Style="{StaticResource SectionHeading}"/>
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TxtWarn1Time" Style="{StaticResource FormInput}" Text="10:00" ToolTip="1st Warning Lead Time (MM:SS before shutdown/restart, e.g. 10:00 = 10 minutes before)"/>
                                        <TextBox Grid.Column="2" x:Name="TxtWarn1Msg" Style="{StaticResource FormInput}" Text="Server will restart in 10 minutes!" ToolTip="1st Warning Broadcast Message sent to all in-game players via RCON"/>
                                    </Grid>

                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TxtWarn2Time" Style="{StaticResource FormInput}" Text="05:00" ToolTip="2nd Warning Lead Time (MM:SS before shutdown/restart, e.g. 05:00 = 5 minutes before)"/>
                                        <TextBox Grid.Column="2" x:Name="TxtWarn2Msg" Style="{StaticResource FormInput}" Text="Server will restart in 5 minutes!" ToolTip="2nd Warning Broadcast Message sent to all in-game players via RCON"/>
                                    </Grid>

                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TxtWarn3Time" Style="{StaticResource FormInput}" Text="02:00" ToolTip="3rd Warning Lead Time (MM:SS before shutdown/restart, e.g. 02:00 = 2 minutes before)"/>
                                        <TextBox Grid.Column="2" x:Name="TxtWarn3Msg" Style="{StaticResource FormInput}" Text="Server will restart in 2 minutes! Find a safe area." ToolTip="3rd Warning Broadcast Message sent to all in-game players via RCON"/>
                                    </Grid>

                                    <CheckBox x:Name="ChkFastRestartZeroPlayers" Content="Early restart if 0 connected players" Style="{StaticResource FormCheck}" IsChecked="True" Margin="0,2,0,0" ToolTip="Fast Restart When Empty&#x0a;Summary: Skips the 10-minute RCON countdown and restarts immediately if 0 players are currently online on the server."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Column 3: Branch, Priority, Backup & Discord -->
                        <StackPanel Grid.Column="3">
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <TextBlock Text="Branch &amp; Process Scaling" Style="{StaticResource SectionHeading}"/>
                                    <ComboBox x:Name="CmbAutoUpdate" Style="{StaticResource FormCombo}" ToolTip="SteamCMD Update Policy&#x0a;Summary: Controls when SteamCMD checks for and installs Conan Exiles Dedicated Server (AppID 443030) &amp; Workshop mod updates.">
                                        <ComboBoxItem Content="Auto-Update On Restart" IsSelected="True"/>
                                        <ComboBoxItem Content="Don't Auto-Update on Restart"/>
                                        <ComboBoxItem Content="Check for Updates and Restart"/>
                                    </ComboBox>

                                    <WrapPanel Margin="0,2,0,0">
                                        <CheckBox x:Name="ChkValidateFiles" Content="Validate Files" Style="{StaticResource FormCheck}" ToolTip="Validate Server Files&#x0a;Summary: Passes 'validate' to SteamCMD during updates to verify and repair corrupted server files (takes longer)."/>
                                        <CheckBox x:Name="ChkStartIfNotRunning" Content="Start if Stopped" Style="{StaticResource FormCheck}" IsChecked="True" ToolTip="Start If Stopped&#x0a;Summary: Automatically starts the server when scheduled tasks or update checks finish."/>
                                        <CheckBox x:Name="ChkAutoStartOnAppLaunch" Content="Auto-Start on Launch" Style="{StaticResource FormCheck}" ToolTip="Auto-Start Server on App Launch&#x0a;Summary: Automatically boots the Conan Exiles Dedicated Server as soon as you open this Server Manager application."/>
                                        <CheckBox x:Name="ChkZombieWatch" Content="Zombie Watch / Auto-Restart" Style="{StaticResource FormCheck}" IsChecked="True" ToolTip="Zombie Watchdog &amp; Crash Recovery&#x0a;Summary: Monitors ConanSandboxServer.exe for unexpected crashes or deadlocks and automatically restarts the server (includes Crash-Loop Mod Culprit detection)."/>
                                        <CheckBox x:Name="ChkAutoCheckAppUpdates" Content="Auto-Check App Updates" Style="{StaticResource FormCheck}" IsChecked="True" ToolTip="Auto-Check Manager Updates&#x0a;Summary: Periodically checks GitHub Releases for newer versions of Conan Server Manager."/>
                                        <CheckBox x:Name="ChkAutoInstallAppUpdates" Content="Auto-Install App Updates" Style="{StaticResource FormCheck}" ToolTip="Auto-Install Manager Updates&#x0a;Summary: Automatically downloads and applies new Conan Server Manager updates when found."/>
                                    </WrapPanel>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" ToolTip="CPU Process Priority Class&#x0a;Summary: Sets the Windows OS scheduling priority for ConanSandboxServer-Win64-Shipping.exe.&#x0a;Options &amp; Hints:&#x0a;• Unmanaged / Normal = Standard OS scheduling&#x0a;• Above Normal / High = Prioritizes server tick rate over background Windows tasks">
                                            <TextBlock Text="Priority Class" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CmbPriorityClass" Style="{StaticResource FormCombo}">
                                                <ComboBoxItem Content="Unmanaged" IsSelected="True"/>
                                                <ComboBoxItem Content="Normal"/>
                                                <ComboBoxItem Content="Above Normal"/>
                                                <ComboBoxItem Content="High"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <CheckBox x:Name="ChkUseAllCores" Content="-useallavailablecores" Style="{StaticResource FormCheck}" IsChecked="True" ToolTip="-useallavailablecores CLI Flag&#x0a;Summary: Instructs Unreal Engine 4 to distribute worker threads across all physical and logical CPU cores."/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Custom Server Directory" Style="{StaticResource FormLabel}" Margin="0,2,0,0"/>
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCustomServerDir" Style="{StaticResource FormInput}" ToolTip="Custom Server Directory&#x0a;Summary: Path where ConanSandboxServer.exe is installed.&#x0a;Hint: Leave empty to use the default &lt;AppFolder&gt;\ConanServer directory."/>
                                        <Button x:Name="BtnBrowseServerDir" Grid.Column="1" Content="📁" Width="26" Margin="4,0,0,0" Style="{StaticResource BtnSecondary}" Click="BtnBrowseServerDir_Click" ToolTip="Browse for a custom Conan Exiles Dedicated Server installation folder"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <TextBlock Text="Discord &amp; Backup Automation" Style="{StaticResource SectionHeading}"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="ChkDiscordEnable" Content="Discord Webhook" Style="{StaticResource FormCheck}" ToolTip="Enable Discord Webhook Notifications&#x0a;Summary: Posts server start, stop, crash, and update alerts to your Discord channel via Webhook."/>
                                        <CheckBox x:Name="ChkDiscordTime" Content="Include Time" Style="{StaticResource FormCheck}" IsChecked="True" ToolTip="Include Timestamp&#x0a;Summary: Prefixes Discord webhook messages with the server's local timestamp."/>
                                    </WrapPanel>
                                    <TextBox x:Name="TxtDiscordWebhook" Style="{StaticResource FormInput}" ToolTip="Discord Webhook URL&#x0a;Summary: Paste the Webhook URL from your Discord Server (Channel Settings → Integrations → Webhooks)."/>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="ChkShutdownBackup" Content="Shutdown Backup" Style="{StaticResource FormCheck}" IsChecked="True" ToolTip="Automatic Backup on Shutdown/Restart&#x0a;Summary: Creates a timestamped ZIP archive of Saved/ (game.db, modlist.txt, and Config/WindowsServer/*.ini) every time the server stops or restarts."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="Backup Retention Limit (Days)&#x0a;Summary: Automatically deletes old backup .zip archives older than this number of days.&#x0a;Options &amp; Hints:&#x0a;• 7 = Keep 1 week of backups (Recommended)&#x0a;• 0 = Keep all backups forever (never auto-delete)">
                                            <TextBlock Text="Backup Limit (Days)" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtBackupDays" Style="{StaticResource FormInput}" Text="7"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Custom Backup Directory" Style="{StaticResource FormLabel}" Margin="0,3,0,0"/>
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCustomBackupDir" Style="{StaticResource FormInput}" ToolTip="Custom Backup Directory&#x0a;Summary: Folder where backup ZIP archives are stored.&#x0a;Hint: Leave empty for default (&lt;AppFolder&gt;\Backups), or point to a secondary drive / NAS share."/>
                                        <Button x:Name="BtnBrowseBackupDir" Grid.Column="1" Content="📁" Width="26" Margin="4,0,0,0" Style="{StaticResource BtnSecondary}" Click="BtnBrowseBackupDir_Click" ToolTip="Browse for a custom backup storage directory"/>
                                    </Grid>

                                    <StackPanel ToolTip="Pre/Post Script Execution&#x0a;Summary: Optionally runs a custom batch script (backup_script.bat / startup_script.bat) before backups or on server startup.">
                                        <TextBlock Text="Pre/Post Script Execution" Style="{StaticResource FormLabel}" Margin="0,2,0,0"/>
                                        <ComboBox x:Name="CmbBackupScriptMode" Style="{StaticResource FormCombo}">
                                            <ComboBoxItem Content="Don't Run Scripts" IsSelected="True"/>
                                            <ComboBoxItem Content="Run .BAT before backup"/>
                                            <ComboBoxItem Content="Run .BAT on startup"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Action Control Buttons & Download Progress Bar -->
                    <StackPanel Grid.Row="1">
                        <!-- Progress Bar Card (Appears live during base server or mod download) -->
                        <Border x:Name="PnlDownloadProgress" Style="{StaticResource GlassPanel}" Margin="2,1,2,3" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TxtDownloadItemInfo" Text="Downloading Mod 1 of 18..." Foreground="#E0E7FF" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtDownloadSpeedEta" Text="Speed: 0.0 MB/s | ETA: --:--:--" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                                </Grid>

                                <ProgressBar Grid.Row="1" x:Name="PbDownloadProgress" Height="14" Minimum="0" Maximum="100" Value="0" Background="#0F172A" Foreground="#6366F1" BorderBrush="#334155"/>
                            </Grid>
                        </Border>

                        <!-- Action Buttons Bar -->
                        <Border Style="{StaticResource GlassPanel}" Margin="2,2,2,3">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="BtnStart" Content="🚀 Update &amp; Start Server" Style="{StaticResource BtnPrimary}" Click="BtnStart_Click" Margin="0,0,6,2"/>
                                <Button x:Name="BtnStartNoUpdate" Content="▶ Start (No Update)" Style="{StaticResource BtnSuccess}" Click="BtnStartNoUpdate_Click" Margin="0,0,6,2"/>
                                <Button x:Name="BtnRestart" Content="🔄 Update &amp; Restart" Style="{StaticResource BtnSecondary}" Click="BtnRestart_Click" Margin="0,0,6,2"/>
                                <Button x:Name="BtnRestartNoUpdate" Content="⚡ Restart (No Update)" Style="{StaticResource BtnSecondary}" Click="BtnRestartNoUpdate_Click" Margin="0,0,6,2"/>
                                <Button x:Name="BtnStop" Content="🛑 Stop Server" Style="{StaticResource BtnDanger}" Click="BtnStop_Click" Margin="0,0,6,2"/>
                                <Button x:Name="BtnBackup" Content="💾 Hot SQLite Backup" Style="{StaticResource BtnSecondary}" Click="BtnBackup_Click" Margin="0,0,6,2"/>
                                <Button x:Name="BtnRestoreBackup" Content="📂 Restore DB" Style="{StaticResource BtnSecondary}" Click="BtnRestoreBackup_Click" Margin="0,0,6,2" ToolTip="Restore a game_0.db or .zip database backup from the Backups folder"/>
                                <Button x:Name="BtnSaveConfig" Content="💾 Save Configuration" Style="{StaticResource BtnSecondary}" Click="BtnSaveConfig_Click" Margin="0,0,6,2"/>
                                <Button x:Name="BtnTestPorts" Content="🔌 Test Ports" Style="{StaticResource BtnSecondary}" Click="BtnTestPorts_Click" Margin="0,0,6,2"/>
                                <Button x:Name="BtnConfigureFirewall" Content="🛡️ Configure Firewall" Style="{StaticResource BtnSecondary}" Click="BtnConfigureFirewall_Click" Margin="0,0,6,2" ToolTip="Open Windows Firewall rules for Game, Peer, Query, RCON, and Web API ports"/>
                                <Button x:Name="BtnCheckAppUpdate" Content="🔄 Check App Updates" Style="{StaticResource BtnSecondary}" Click="BtnCheckAppUpdate_Click" Margin="0,0,6,2"/>
                                <Button x:Name="BtnOpenWorkshopBrowser" Content="🌐 Steam Workshop Browser" Style="{StaticResource BtnSuccess}" Click="BtnOpenWorkshopBrowser_Click" Margin="0,0,0,2" ToolTip="Open full-page Steam Workshop browser to search and install mods"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>

                    <!-- Split View - Left: Permanent Players Online Panel | Right: Multi-Tab Console & Editor Panel -->
                    <Grid Grid.Row="2" Margin="2,2,2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="220" MaxWidth="500"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Permanent Players Online Sidebar -->
                        <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header -->
                                    <RowDefinition Height="*"/>    <!-- Player List / Empty State -->
                                    <RowDefinition Height="Auto"/> <!-- Action Footer -->
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="8,6" CornerRadius="4,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👥" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="PLAYERS ONLINE" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtPlayersCountBadge" Text="0 / 40" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Player List Area -->
                                <Grid Grid.Row="1" Margin="0,4,0,4">
                                    <ListBox x:Name="LstConnectedPlayers" Background="Transparent" BorderThickness="0" 
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2,1">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Online: " FontSize="9" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding DurationFormatted}" FontSize="9" Foreground="#94A3B8" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Score: " FontSize="9" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding Score}" FontSize="9" Foreground="#94A3B8"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="4" Padding="4,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding PingText}" FontSize="9" Foreground="#34D399" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Empty State Placeholder -->
                                    <StackPanel x:Name="PnlNoPlayers" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                        <TextBlock Text="👤" FontSize="26" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,4"/>
                                        <TextBlock Text="No players currently online" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Connected players will appear here automatically." Foreground="#475569" FontSize="9" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Action Footer -->
                                <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="6,5" CornerRadius="0,0,4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnRefreshPlayers" Content="🔄 Refresh" Style="{StaticResource BtnSecondary}" FontSize="10" Padding="0,3" Click="BtnRefreshPlayers_Click"/>
                                        <Button Grid.Column="2" x:Name="BtnKickSelectedPlayer" Content="⚠️ Kick" Style="{StaticResource BtnDanger}" FontSize="10" Padding="0,3" Click="BtnKickSelectedPlayer_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Column 1: Resizable Splitter -->
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#1E293B" Cursor="SizeWE"/>

                        <!-- Column 2: Multi-Tab Console & Editor Panel -->
                        <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Margin="0,0,0,0" VerticalAlignment="Stretch">
                            <TabControl x:Name="MainTabControl" Background="#020617" BorderBrush="#334155" Foreground="#E2E8F0" VerticalAlignment="Stretch">
                                <!-- Tab 1: Server Log -->
                                <TabItem Header="Server Log">
                                    <Grid VerticalAlignment="Stretch">
                                        <TextBox x:Name="TxtServerLog" Background="#020617" Foreground="#38BDF8" 
                                                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                                 TextWrapping="Wrap" BorderThickness="0" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 2: Errors -->
                                <TabItem Header="Errors">
                                    <Grid VerticalAlignment="Stretch">
                                        <TextBox x:Name="TxtErrorLog" Background="#020617" Foreground="#F87171" 
                                                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                                 TextWrapping="Wrap" BorderThickness="0" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 3: Chat -->
                                <TabItem Header="Chat">
                                    <Grid VerticalAlignment="Stretch" Margin="6">
                                        <TextBox x:Name="TxtChatLog" Background="#020617" Foreground="#A7F3D0" 
                                                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                                 TextWrapping="Wrap" BorderThickness="0" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 4: Mods -->
                                <TabItem Header="Mods">
                                    <Grid Margin="10" VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Column 0: Active & Disabled Mods Lists -->
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Mod Updates Banner -->
                                                <RowDefinition Height="Auto"/> <!-- Active Mods Header + Quick Workshop Search -->
                                                <RowDefinition Height="*"/>    <!-- Active Mods ListBox -->
                                                <RowDefinition Height="6"/>    <!-- Spacer -->
                                                <RowDefinition Height="Auto"/> <!-- Inactive Mods Section -->
                                            </Grid.RowDefinitions>

                                            <!-- Mod Updates Banner -->
                                            <Border Grid.Row="0" x:Name="PnlModUpdatesBanner" Background="#1E1B4B" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtModUpdatesBanner" Text="Updates available for installed mods on Steam Workshop!" Foreground="#C7D2FE" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="🔄 Check Updates" Style="{StaticResource BtnSecondary}" Padding="8,2" FontSize="10" Click="BtnCheckModUpdates_Click"/>
                                                </Grid>
                                            </Border>

                                            <!-- Active Mods Header & Quick Workshop Search -->
                                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="▶ Active Mods (Loaded by Server)" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                                                    <TextBlock x:Name="TxtActiveModsCount" Text="(0 mods)" Foreground="#94A3B8" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox x:Name="TxtQuickWorkshopSearch" Style="{StaticResource FormInput}" Width="180" Margin="0,0,4,0" KeyDown="TxtQuickWorkshopSearch_KeyDown" ToolTip="Quick search Steam Workshop mods by name or keyword"/>
                                                    <Button x:Name="BtnQuickWorkshopSearch" Content="🔍 Search Workshop" Style="{StaticResource BtnSecondary}" Padding="8,2" FontSize="10" Click="BtnQuickWorkshopSearch_Click" ToolTip="Search Steam Workshop in built-in browser"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Active Mods ListBox -->
                                            <ListBox Grid.Row="2" x:Name="LstMods" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" 
                                                     VerticalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     PreviewMouseRightButtonDown="LstMods_PreviewMouseRightButtonDown">
                                                <ListBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="⏸️ Disable Mod (Move to Inactive)" Click="BtnDisableMod_Click"/>
                                                        <MenuItem Header="📥 Pre-Download / Verify Mod Files Now" Click="MnuPreDownloadMod_Click"/>
                                                        <MenuItem Header="🌐 View in Workshop Browser" Click="MnuViewInModBrowser_Click"/>
                                                        <MenuItem Header="🌐 Open in External Browser" Click="MnuOpenWorkshopPage_Click"/>
                                                        <MenuItem Header="📋 Copy Workshop URL" Click="MnuCopyWorkshopUrl_Click"/>
                                                        <MenuItem Header="📋 Copy Mod ID" Click="MnuCopyModId_Click"/>
                                                        <Separator/>
                                                        <MenuItem Header="🗑️ Remove Mod" Click="BtnRemoveMod_Click"/>
                                                    </ContextMenu>
                                                </ListBox.ContextMenu>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="6,5" Margin="0,1">
                                                             <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="🧩" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#94A3B8"/>
                                                                        <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="#38BDF8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" CornerRadius="6" Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center" Margin="6,0,2,0">
                                                                    <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <!-- Inactive / Disabled Mods Section -->
                                            <Border Grid.Row="4" x:Name="PnlDisabledMods" Background="#0B132B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="6" MaxHeight="170">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="⏸️ Inactive / Disabled Mods" FontWeight="Bold" FontSize="11" Foreground="#A78BFA"/>
                                                            <Border CornerRadius="8" Background="#1E293B" BorderBrush="#818CF8" BorderThickness="1" Margin="6,0,0,0" Padding="5,1">
                                                                <TextBlock x:Name="TxtDisabledModsCount" Text="0" Foreground="#A5B4FC" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="(Files kept on disk, excluded from server)" Foreground="#64748B" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button x:Name="BtnEnableSelectedDisabledMod" Content="▶️ Re-Enable" Style="{StaticResource BtnSuccess}" Padding="6,2" FontSize="9" FontWeight="Bold" Click="BtnEnableSelectedDisabledMod_Click" Margin="0,0,4,0" ToolTip="Restore selected inactive mod back to active server load order"/>
                                                            <Button x:Name="BtnDeleteSelectedDisabledMod" Content="🗑️ Remove" Style="{StaticResource BtnDanger}" Padding="6,2" FontSize="9" Click="BtnDeleteSelectedDisabledMod_Click" ToolTip="Permanently remove selected inactive mod"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <ListBox Grid.Row="1" x:Name="LstDisabledMods" Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#1E293B" MaxHeight="120"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             PreviewMouseRightButtonDown="LstDisabledMods_PreviewMouseRightButtonDown">
                                                        <ListBox.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="▶️ Enable Mod (Restore to Server)" Click="MnuEnableDisabledMod_Click"/>
                                                                <MenuItem Header="🌐 View in Workshop Browser" Click="MnuViewDisabledInModBrowser_Click"/>
                                                                <MenuItem Header="🌐 Open in External Browser" Click="MnuOpenDisabledWorkshopPage_Click"/>
                                                                <MenuItem Header="📋 Copy Mod ID" Click="MnuCopyDisabledModId_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="🗑️ Remove Mod Permanently" Click="MnuRemoveDisabledMod_Click"/>
                                                            </ContextMenu>
                                                        </ListBox.ContextMenu>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="4,3" Margin="0,1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="⏸️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                                <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="#64748B"/>
                                                                                <TextBlock Text="{Binding CategoryName}" FontSize="9" Foreground="#818CF8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                        <Border Grid.Column="2" CornerRadius="4" Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" Padding="5,2" VerticalAlignment="Center" Margin="4,0,2,0">
                                                                            <TextBlock Text="{Binding StatusBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Column 2: Action Control Buttons -->
                                        <StackPanel Grid.Column="2">
                                            <Button x:Name="BtnCheckModUpdates" Content="🔄 Check Updates" Style="{StaticResource BtnSecondary}" Click="BtnCheckModUpdates_Click" Margin="0,0,0,6" ToolTip="Query Steam Workshop to check if authors released updates for installed mods"/>
                                            <Button x:Name="BtnAutoSortMods" Content="🪄 Auto-Sort Order" Style="{StaticResource BtnSuccess}" Click="BtnAutoSortMods_Click" Margin="0,0,0,6" ToolTip="Intelligently sort active mods according to recommended Conan Exiles load order rules (Core frameworks 1st, Tweaks, Items, Patches last)"/>
                                            <Button Content="Move Up ▲" Style="{StaticResource BtnSecondary}" Click="BtnModMoveUp_Click" Margin="0,0,0,4"/>
                                            <Button Content="Move Down ▼" Style="{StaticResource BtnSecondary}" Click="BtnModMoveDown_Click" Margin="0,0,0,6"/>
                                            <Button x:Name="BtnPreDownloadMod" Content="📥 Pre-Download Mod" Style="{StaticResource BtnSecondary}" Click="BtnPreDownloadMod_Click" Margin="0,0,0,6" ToolTip="Pre-download or verify the selected mod's files via SteamCMD in the background"/>
                                            <Button x:Name="BtnDisableMod" Content="⏸️ Disable Mod" Style="{StaticResource BtnSecondary}" Click="BtnDisableMod_Click" Margin="0,0,0,6" ToolTip="Move selected mod to Inactive Mods list without deleting downloaded files"/>
                                            <Button x:Name="BtnOpenModBrowser" Content="🌐 Browse Workshop" Style="{StaticResource BtnSuccess}" Click="BtnOpenModBrowser_Click" Margin="0,0,0,10" ToolTip="Open the integrated Steam Workshop browser to search and add mods"/>
                                            <TextBlock Text="Add Mod ID" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtNewModId" Style="{StaticResource FormInput}" Margin="0,0,0,4"/>
                                            <Button Content="Add Mod" Style="{StaticResource BtnPrimary}" Click="BtnAddMod_Click" Margin="0,0,0,4"/>
                                            <Button Content="Remove Mod" Style="{StaticResource BtnDanger}" Click="BtnRemoveMod_Click" Margin="0,0,0,6"/>
                                            <Button Content="🌐 View on Workshop" Style="{StaticResource BtnSecondary}" Click="BtnViewModWorkshop_Click" Margin="0,0,0,6" ToolTip="Open the selected mod's Steam Workshop page in browser"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 5: SteamCMD Log -->
                                <TabItem Header="SteamCMD Log">
                                    <Grid VerticalAlignment="Stretch">
                                        <TextBox x:Name="TxtSteamCmdLog" Background="#020617" Foreground="#FBBF24" 
                                                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                                 TextWrapping="Wrap" BorderThickness="0" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 6: Engine.ini -->
                                <TabItem Header="Engine.ini">
                                    <Grid Margin="6" VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0" x:Name="TxtEngineIni" Background="#020617" Foreground="#E2E8F0" 
                                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" VerticalAlignment="Stretch"/>
                                        <Button Grid.Row="1" Content="Save Engine.ini" Style="{StaticResource BtnSecondary}" Click="BtnSaveEngineIni_Click" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 7: ServerSettings.ini -->
                                <TabItem Header="ServerSettings.ini">
                                    <Grid Margin="6" VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0" x:Name="TxtServerSettingsIni" Background="#020617" Foreground="#E2E8F0" 
                                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" VerticalAlignment="Stretch"/>
                                        <Button Grid.Row="1" Content="Save ServerSettings.ini" Style="{StaticResource BtnSecondary}" Click="BtnSaveServerSettingsIni_Click" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 8: Game.ini -->
                                <TabItem Header="Game.ini">
                                    <Grid Margin="6" VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0" x:Name="TxtGameIni" Background="#020617" Foreground="#E2E8F0" 
                                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" VerticalAlignment="Stretch"/>
                                        <Button Grid.Row="1" Content="Save Game.ini" Style="{StaticResource BtnSecondary}" Click="BtnSaveGameIni_Click" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 9: Launcher Log -->
                                <TabItem Header="Launcher Log">
                                    <Grid VerticalAlignment="Stretch">
                                        <TextBox x:Name="TxtLauncherLog" Background="#020617" Foreground="#CBD5E1" 
                                                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                                 TextWrapping="Wrap" BorderThickness="0" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TOP-LEVEL TAB 2: FULL-WINDOW GAMEPLAY & SERVERSETTINGS.INI CONFIGURATOR -->
            <TabItem Padding="14,5" FontSize="12" FontWeight="Bold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️ Gameplay &amp; ServerSettings.ini" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="6" VerticalAlignment="Stretch" Background="#0F172A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Toolbar -->
                    <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⚙️ Conan Exiles Enhanced — Gameplay &amp; ServerSettings.ini Configurator" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                                <TextBlock Text="Configure server rules, combat mode, harvest/XP multipliers, Purge, and building decay directly across the full window without logging into the game." Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnReloadGameplayIni" Content="🔄 Reload from INI" Style="{StaticResource BtnSecondary}" Click="BtnReloadGameplayIni_Click" Margin="0,0,8,0" Padding="10,6" FontSize="11" ToolTip="Read current values from ServerSettings.ini on disk"/>
                                <Button x:Name="BtnResetGameplayDefaults" Content="↺ Reset to Vanilla (1.0x)" Style="{StaticResource BtnSecondary}" Click="BtnResetGameplayDefaults_Click" Margin="0,0,8,0" Padding="10,6" FontSize="11" ToolTip="Reset multipliers and rules to official Funcom defaults"/>
                                <Button x:Name="BtnSaveGameplaySettings" Content="💾 Save &amp; Apply Gameplay Settings" Style="{StaticResource BtnSuccess}" Click="BtnSaveConfig_Click" Padding="14,6" FontSize="11" ToolTip="Save configuration and write all settings to ServerSettings.ini"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable 3-Column Full-Window Settings Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Combat Mode, General Rules, Death & Ownership -->
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource GlassPanel}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="⚔️ Combat Mode &amp; General Rules" Style="{StaticResource SectionHeading}" FontSize="12" Margin="0,0,0,4"/>
                                        <StackPanel ToolTip="Server Combat Mode Preset (CombatModeModifier in ServerSettings.ini)&#x0a;Summary: Quick-select preset that configures PvP and structure damage flags together.&#x0a;Options &amp; Hints:&#x0a;• PvE = Cooperative play; players cannot hurt other players or their bases&#x0a;• PvE-Conflict = Players can fight each other, but player-built bases are indestructible&#x0a;• PvP = Full open-world player combat and base raiding enabled&#x0a;• Custom Combat Rules = Mix and match individual checkboxes below">
                                            <TextBlock Text="Server Combat Mode Preset" Style="{StaticResource FormLabel}" FontSize="11"/>
                                            <ComboBox x:Name="CmbCombatModePreset" Style="{StaticResource FormCombo}" FontSize="11" Padding="5,3" SelectionChanged="CmbCombatModePreset_SelectionChanged" Margin="0,2,0,6">
                                                <ComboBoxItem Content="PvE (Players cannot damage players or buildings)" Tag="PVE" IsSelected="True"/>
                                                <ComboBoxItem Content="PvE-Conflict (Player PvP enabled, buildings indestructible)" Tag="PVEC"/>
                                                <ComboBoxItem Content="PvP (Full PvP &amp; building raid damage enabled)" Tag="PVP"/>
                                                <ComboBoxItem Content="Custom Combat Rules" Tag="CUSTOM"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Margin="0,2,0,6">
                                            <CheckBox x:Name="ChkGameplayPvpEnabled" Content="PVPEnabled (Player vs Player Combat)" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" ToolTip="PVPEnabled (ServerSettings.ini)&#x0a;Summary: Allows players outside the same clan to deal weapon, thrall, and status damage to each other.&#x0a;Options &amp; Hints:&#x0a;• Unchecked (False) = Pure PvE (players cannot harm each other)&#x0a;• Checked (True) = Players can fight each other (used in PvE-Conflict &amp; PvP)"/>
                                            <CheckBox x:Name="ChkGameplayCanDamageStructures" Content="CanDamagePlayerOwnedStructures (Building Raid Damage)" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" ToolTip="CanDamagePlayerOwnedStructures (ServerSettings.ini)&#x0a;Summary: Allows players to damage and destroy bases/structures owned by other clans using explosives, trebuchets, or weapons.&#x0a;Options &amp; Hints:&#x0a;• Unchecked (False) = Player bases cannot be raided by other players (PvE / PvE-Conflict)&#x0a;• Checked (True) = Base raiding enabled (PvP)"/>
                                            <CheckBox x:Name="ChkGameplayDynamicBuildingDamage" Content="DynamicBuildingDamage (Raid Window Protection)" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" ToolTip="DynamicBuildingDamage (ServerSettings.ini)&#x0a;Summary: Prevents offline raiding — player bases can ONLY be damaged while at least one member of the owning clan is online (plus a short cooldown after logout).&#x0a;Options &amp; Hints:&#x0a;• Unchecked (False) = Bases can be raided anytime raid damage is active&#x0a;• Checked (True) = Protects offline clans from having their bases wiped while away"/>
                                            <CheckBox x:Name="ChkGameplayEnableSandStorm" Content="EnableSandStorm (Periodic Desert Sandstorms)" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" IsChecked="True" ToolTip="EnableSandStorm (ServerSettings.ini)&#x0a;Summary: Enables the periodic deadly sandstorm that sweeps across the southern/central Exiled Lands desert.&#x0a;Vanilla Default: Checked (True)&#x0a;Hint: Uncheck only if you want peaceful weather without needing a Sandstorm Mask or shelter."/>
                                        </StackPanel>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="MaxNudity (ServerSettings.ini)&#x0a;Summary: Sets the maximum nudity level permitted on the server (caps each player's client setting).&#x0a;Vanilla Default: 2 - Full&#x0a;Options:&#x0a;• 0 - None = Loincloths and chest wraps always worn&#x0a;• 1 - Partial = Topless allowed, lower body covered&#x0a;• 2 - Full = Unrestricted full nudity allowed">
                                                <TextBlock Text="Max Nudity" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <ComboBox x:Name="CmbGameplayMaxNudity" Style="{StaticResource FormCombo}" FontSize="11" Padding="4,3">
                                                    <ComboBoxItem Content="0 - None"/>
                                                    <ComboBoxItem Content="1 - Partial"/>
                                                    <ComboBoxItem Content="2 - Full" IsSelected="True"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="clanMaxSize (ServerSettings.ini)&#x0a;Summary: Maximum number of players that can belong to a single Clan.&#x0a;Vanilla Default: 10&#x0a;Options &amp; Hints:&#x0a;• 5 = Small squad PvP balance&#x0a;• 10 = Official server standard&#x0a;• 20–30 = Large community / PVE guild server">
                                                <TextBlock Text="Max Clan Size" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayClanMaxSize" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="MaxAllowedPing (ServerSettings.ini)&#x0a;Summary: Automatically kicks or blocks players whose network latency (ping in ms) exceeds this limit.&#x0a;Vanilla Default: 0 (Disabled)&#x0a;Options &amp; Hints:&#x0a;• 0 = No ping limit (Recommended for friends playing across regions)&#x0a;• 200–300 = Kick high-latency connections on competitive PvP servers">
                                                <TextBlock Text="Max Ping (0=Off)" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayMaxAllowedPing" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassPanel}" Padding="10" Margin="2,6,2,2">
                                    <StackPanel>
                                        <TextBlock Text="💀 Death, Corpse &amp; Container Ownership" Style="{StaticResource SectionHeading}" FontSize="12" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ChkGameplayDropEquipment" Content="Drop Equipment on Death" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" IsChecked="True" ToolTip="DropEquipmentOnDeath (ServerSettings.ini)&#x0a;Summary: Controls whether worn armor and equipped weapons stay on your corpse when you die.&#x0a;Vanilla Default: Checked (True)&#x0a;Options &amp; Hints:&#x0a;• Checked (True) = Worn armor/weapons drop on your corpse&#x0a;• Unchecked (False) = You respawn still wearing your equipped armor &amp; weapons (Casual / QoL)"/>
                                        <CheckBox x:Name="ChkGameplayDropShortcutBar" Content="Drop Shortcut Bar on Death" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" IsChecked="True" ToolTip="DropShortcutBarOnDeath (ServerSettings.ini)&#x0a;Summary: Controls whether items on your 1–8 hotbar/shortcut wheel are dropped on your corpse upon death.&#x0a;Vanilla Default: Checked (True)&#x0a;Options &amp; Hints:&#x0a;• Checked (True) = Hotbar items remain on corpse&#x0a;• Unchecked (False) = You keep your hotbar weapons/tools/potions when respawning"/>
                                        <CheckBox x:Name="ChkGameplayDropBackpack" Content="Drop Backpack Inventory on Death" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" IsChecked="True" ToolTip="DropBackpackOnDeath (ServerSettings.ini)&#x0a;Summary: Controls whether main backpack inventory items are dropped on your corpse upon death.&#x0a;Vanilla Default: Checked (True)&#x0a;Options &amp; Hints:&#x0a;• Checked (True) = Backpack loot drops on your corpse and must be recovered&#x0a;• Unchecked (False) = Keep all backpack items when you die (uncheck all 3 'Drop' boxes for full Keep-Inventory)"/>
                                        <CheckBox x:Name="ChkGameplayEverybodyLootCorpse" Content="Everybody Can Loot Corpse" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" IsChecked="True" ToolTip="EverybodyCanLootCorpse (ServerSettings.ini)&#x0a;Summary: Determines whether other players can loot your dead body, or if only you can access your own corpse.&#x0a;Vanilla Default: Checked (True)&#x0a;Options &amp; Hints:&#x0a;• Checked (True) = Anyone can loot player corpses (standard for PvP, or allows friends to help recover your gear)&#x0a;• Unchecked (False) = Only the dead player can loot their own corpse (prevents corpse theft on public PvE)"/>
                                        <CheckBox x:Name="ChkGameplayLogoutCharsRemain" Content="Logged-Out Bodies Remain in World" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" IsChecked="True" ToolTip="LogoutCharactersRemainInTheWorld (ServerSettings.ini)&#x0a;Summary: Controls whether sleeping player bodies stay in the game world when a player disconnects.&#x0a;Vanilla Default: Checked (True)&#x0a;Options &amp; Hints:&#x0a;• Checked (True) = Unconscious body stays where the player logged out&#x0a;• Unchecked (False) = Character disappears from the world on logout (safer against temperature/starvation/raids)"/>
                                        <CheckBox x:Name="ChkGameplayContainersIgnoreOwnership" Content="Containers Ignore Ownership (Unlocked)" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" IsChecked="True" ToolTip="ContainersIgnoreOwnership (ServerSettings.ini)&#x0a;Summary: Controls whether chests, crafting stations, and vaults can be opened by players outside your clan.&#x0a;Vanilla Default: Checked (True)&#x0a;Options &amp; Hints:&#x0a;• Checked (True) = All chests and benches are accessible by everyone&#x0a;• Unchecked (False) = Containers are locked to the owning player/clan by default (Recommended for multi-clan public PvE)"/>
                                        <CheckBox x:Name="ChkGameplayNoOwnership" Content="No Ownership (All Structures Shared)" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" ToolTip="NoOwnership (ServerSettings.ini)&#x0a;Summary: Disables individual/clan ownership rules completely so all doors, buildings, and stations belong to everyone.&#x0a;Vanilla Default: Unchecked (False)&#x0a;Hint: Leave Unchecked unless running a purely communal co-op server without clans."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassPanel}" Padding="10" Margin="2,6,2,2">
                                    <StackPanel>
                                        <TextBlock Text="🏰 Building Decay, Purge &amp; Avatars" Style="{StaticResource SectionHeading}" FontSize="12" Margin="0,0,0,4"/>
                                        <StackPanel Margin="0,1,0,6">
                                            <CheckBox x:Name="ChkGameplayDisableAbandonment" Content="Disable Building Decay / Abandonment" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" IsChecked="True" ToolTip="DisableBuildingAbandonment (ServerSettings.ini)&#x0a;Summary: Stops player-built bases and placeables from decaying and crumbling away when players don't log in for several days.&#x0a;Vanilla Default: Unchecked (False) | Manager Default: Checked (True)&#x0a;Options &amp; Hints:&#x0a;• Checked (True) = Buildings NEVER decay over time (Recommended for private/friends servers)&#x0a;• Unchecked (False) = Abandoned bases decay and despawn after inactivity"/>
                                            <CheckBox x:Name="ChkGameplayBuildAnywhere" Content="Allow Building Anywhere (Overlap NPC Camps)" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" ToolTip=" EnableBuildingAnywhere (ServerSettings.ini)&#x0a;Summary: Removes no-build zone restrictions around obelisks, dungeons, and NPC camps.&#x0a;Vanilla Default: Unchecked (False)&#x0a;Options &amp; Hints:&#x0a;• Unchecked (False) = Standard no-build zones protect NPC spawns &amp; lore sites&#x0a;• Checked (True) = Players can build anywhere on the map (Warning: building directly over NPC spawn points can block those NPCs from spawning)"/>
                                            <CheckBox x:Name="ChkGameplayEnablePurge" Content="Enable The Purge" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" IsChecked="True" ToolTip="EnablePurge (ServerSettings.ini)&#x0a;Summary: Enables the Purge / Coffer base-siege invasion system where waves of NPC attackers assault player bases.&#x0a;Vanilla Default: Checked (True)"/>
                                            <CheckBox x:Name="ChkGameplayAvatarsDisabled" Content="Disable God Avatars" Style="{StaticResource FormCheck}" FontSize="11" Margin="0,2" ToolTip="AvatarsDisabled (ServerSettings.ini)&#x0a;Summary: Prevents players from summoning giant God Avatars (Mitra, Set, Yog, Ymir, Derketo, Jhebbal Sag, Zath) at Tier 3 altars.&#x0a;Vanilla Default: Unchecked (False)&#x0a;Hint: Check (True) on PvP servers if you want to prevent True Name Avatar base wipes."/>
                                        </StackPanel>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="BuildingDecayTimeMultiplier (ServerSettings.ini)&#x0a;Summary: Scales how long it takes for buildings to decay when Building Decay is enabled.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = Slower decay (e.g. 2.0 = bases last twice as long before decaying)&#x0a;• Lower = Faster decay (e.g. 0.5 = bases decay in half the time)&#x0a;• Ignored if 'Disable Building Decay / Abandonment' is checked above.">
                                                <TextBlock Text="Decay Time Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayBuildingDecayMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="LandClaimRadiusMultiplier (ServerSettings.ini)&#x0a;Summary: Controls the size of the land-claim radius around player foundations (which blocks other clans from building nearby and prevents trees/rocks from respawning too close).&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• 0.25–0.5 = Smaller claim radius (trees/iron respawn right outside your walls &amp; clans can build closer together)&#x0a;• 1.0 = Official default radius">
                                                <TextBlock Text="Land Claim Radius" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayLandClaimMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="PurgeLevel (ServerSettings.ini)&#x0a;Summary: Sets the maximum difficulty tier of Purge NPC waves (0 to 6).&#x0a;Vanilla Default: 6&#x0a;Options &amp; Hints:&#x0a;• 0 = Turns off Purge attacks&#x0a;• 1–3 = Easier Purge waves (fewer skull bosses)&#x0a;• 6 = Maximum difficulty waves (Required for Tier 4 Purge-exclusive named thralls)">
                                                <TextBlock Text="Purge Level (0-6)" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayPurgeLevel" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="6"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 1: Progression (XP) & Harvesting / Crafting / Thralls -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource GlassPanel}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="📈 Experience (XP) Multipliers" Style="{StaticResource SectionHeading}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="PlayerXPRateMultiplier (ServerSettings.ini)&#x0a;Summary: Master multiplier that scales ALL experience points earned by players and followers from every source.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = Faster leveling (e.g. 2.0 = 2x XP, 5.0 = 5x XP)&#x0a;• Lower = Slower, grindier leveling (e.g. 0.5 = half XP)">
                                                <TextBlock Text="Overall XP Rate Multiplier" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayXpRateMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="PlayerXPTimeMultiplier (ServerSettings.ini)&#x0a;Summary: Scales passive experience gained simply by surviving over time.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• 0.0 = Disable passive survival XP (must earn XP actively)&#x0a;• 1.0 = Standard passive XP&#x0a;• 2.0+ = Faster passive XP trickle">
                                                <TextBlock Text="XP Time (Passive) Multiplier" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayXpTimeMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="PlayerXPKillMultiplier (ServerSettings.ini)&#x0a;Summary: Scales experience earned from killing monsters, animals, bosses, and NPCs (also affects follower/thrall combat leveling).&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = More XP per kill (e.g. 2.0 = 2x combat XP, 3.0 = 3x combat XP)">
                                                <TextBlock Text="XP Kill Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayXpKillMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="PlayerXPHarvestMultiplier (ServerSettings.ini)&#x0a;Summary: Scales experience earned when mining stone/iron, chopping wood, or gathering plants.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = More XP per resource node harvested (e.g. 2.0 = 2x harvesting XP)">
                                                <TextBlock Text="XP Harvest Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayXpHarvestMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="PlayerXPCraftMultiplier (ServerSettings.ini)&#x0a;Summary: Scales experience earned when crafting items, armor, weapons, and building pieces.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = More XP per crafted item (e.g. 2.0 = 2x crafting XP)">
                                                <TextBlock Text="XP Craft Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayXpCraftMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassPanel}" Padding="10" Margin="2,6,2,2">
                                    <StackPanel>
                                        <TextBlock Text="⛏️ Harvesting, Crafting &amp; Thrall Multipliers" Style="{StaticResource SectionHeading}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="HarvestAmountMultiplier (ServerSettings.ini)&#x0a;Summary: Multiplies the amount of resources (stone, wood, iron, hides, meat) gathered per swing.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = More resources per hit (e.g. 2.0 = 2x yield, 3.0 = 3x yield, 5.0 = 5x yield)">
                                                <TextBlock Text="Harvest Amount Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayHarvestMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="ResourceRespawnSpeedMultiplier (ServerSettings.ini)&#x0a;Summary: Controls how fast harvested trees, rocks, and ore nodes respawn.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = Faster resource respawn (e.g. 2.0 = nodes respawn twice as fast)&#x0a;• Lower = Slower resource respawn (e.g. 0.5 = takes twice as long)">
                                                <TextBlock Text="Resource Respawn Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayResourceRespawnMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="PlayerEncumbranceMultiplier (ServerSettings.ini)&#x0a;Summary: Scales how much weight each item adds to your character's carry load.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Carry MORE weight! (e.g. 0.5 = items weigh half as much, 0.1 = 10x carry capacity, 0.0 = infinite carry weight)&#x0a;• Higher = Items feel heavier (e.g. 2.0 = half carry capacity)">
                                                <TextBlock Text="Encumbrance Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayEncumbranceMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="ItemConvertionMultiplier (ServerSettings.ini)&#x0a;Summary: Scales the time required to craft items and smelt ore at workbenches and furnaces.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = FASTER crafting! (e.g. 0.5 = 2x faster, 0.25 = 4x faster, 0.1 = 10x faster / near-instant)&#x0a;• Higher = Slower crafting (e.g. 2.0 = takes twice as long)">
                                                <TextBlock Text="Crafting Time Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayItemConvertMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="ThrallConversionMultiplier (ServerSettings.ini)&#x0a;Summary: Scales how long it takes to break/tame captured human NPCs on the Wheel of Pain.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = FASTER thrall breaking! (e.g. 0.5 = 2x faster, 0.2 = 5x faster, 0.05 = very fast)&#x0a;• Higher = Slower thrall breaking">
                                                <TextBlock Text="Thrall Taming Time Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayThrallConvertMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="AnimalPenCraftingTimeMultiplier (ServerSettings.ini)&#x0a;Summary: Scales how long it takes to raise baby animals and horses in Animal Pens and Stables.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = FASTER pet/mount raising! (e.g. 0.5 = 2x faster, 0.2 = 5x faster)&#x0a;• Higher = Slower pet taming">
                                                <TextBlock Text="Pet Taming Time Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayAnimalPenMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="SpoilRateScale (ServerSettings.ini)&#x0a;Summary: Controls how fast raw meat, cooked food, and gruel spoil and rot.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Food lasts LONGER! (e.g. 0.5 = spoils at half speed, 0.1 = lasts 10x longer, 0.0 = food never spoils)&#x0a;• Higher = Food rots faster">
                                                <TextBlock Text="Food Spoil Rate Scale" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplaySpoilRateScale" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="FuelBurnTimeMultiplier (ServerSettings.ini)&#x0a;Summary: Scales how long wood, coal, oil, and gruel burn inside furnaces, campfires, and Wheels of Pain.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = Fuel lasts LONGER! (e.g. 2.0 = 1 piece of coal burns twice as long, 5.0 = 5x fuel efficiency)&#x0a;• Lower = Fuel burns out faster">
                                                <TextBlock Text="Fuel Burn Time Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayFuelBurnMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="CraftingeCostMultiplier (ServerSettings.ini)&#x0a;Summary: Scales the material ingredient cost required to craft items and building pieces.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Cheaper recipes (e.g. 0.5 = half material cost)&#x0a;• 1.0 = Standard official recipe costs (Recommended to avoid rounding issues on 1-ingredient items)">
                                                <TextBlock Text="Crafting Cost Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayCraftingCostMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassPanel}" Padding="10" Margin="2,6,2,2">
                                    <StackPanel>
                                        <TextBlock Text="☀️ Day / Night Cycle Speeds" Style="{StaticResource SectionHeading}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="DayCycleSpeedScale (ServerSettings.ini)&#x0a;Summary: Master speed multiplier for the entire 24-hour in-game day/night clock (~30 real minutes at 1.0).&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Longer days &amp; nights (e.g. 0.5 = 60-minute full cycle)&#x0a;• Higher = Faster clock (e.g. 2.0 = 15-minute full cycle)">
                                                <TextBlock Text="Overall Cycle" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayDayCycleScale" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="DayTimeSpeedScale (ServerSettings.ini)&#x0a;Summary: Controls how fast time passes during bright daytime hours (07:00 to 16:59).&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = LONGER daytime! (e.g. 0.5 = daylight lasts twice as long)&#x0a;• Higher = Shorter daytime">
                                                <TextBlock Text="Daytime Speed" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayDayTimeScale" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="NightTimeSpeedScale (ServerSettings.ini)&#x0a;Summary: Controls how fast time passes during dark nighttime hours (19:00 to 04:59).&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = SHORTER nights! (e.g. 2.0 or 3.0 = dark nights pass 2x–3x faster)&#x0a;• Lower = Longer nights (e.g. 0.5 = nights last twice as long)">
                                                <TextBlock Text="Night Speed" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayNightTimeScale" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6" ToolTip="DawnDuskSpeedScale (ServerSettings.ini)&#x0a;Summary: Controls how fast time passes during sunrise (05:00–06:59) and sunset (17:00–18:59).&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Longer golden-hour sunrises/sunsets (e.g. 0.5)&#x0a;• Higher = Faster transition between day and night">
                                                <TextBlock Text="Dawn/Dusk" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayDawnDuskScale" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 2: Survival, Stamina, Durability & Combat Damage Multipliers -->
                            <StackPanel Grid.Column="4">
                                <Border Style="{StaticResource GlassPanel}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="🍗 Survival, Stamina &amp; Durability Multipliers" Style="{StaticResource SectionHeading}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="PlayerStaminaCostMultiplier (ServerSettings.ini)&#x0a;Summary: Scales how much stamina is consumed when attacking, dodging, climbing, and sprinting.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Uses LESS stamina! (e.g. 0.5 = half stamina drain, 0.1 = 10x stamina endurance)&#x0a;• Higher = Uses more stamina per action">
                                                <TextBlock Text="Stamina Cost Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayStaminaCostMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="DurabilityMultiplier (ServerSettings.ini)&#x0a;Summary: Scales how quickly weapons, armor, and harvesting tools lose durability when used.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Gear lasts LONGER! (e.g. 0.5 = lasts twice as long, 0.0 = weapons/tools/armor never break)&#x0a;• Higher = Gear breaks faster">
                                                <TextBlock Text="Item Durability Loss" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayDurabilityMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="ShieldDurabilityMultiplier (ServerSettings.ini)&#x0a;Summary: Scales how much durability shields lose when blocking attacks.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Shields last LONGER! (e.g. 0.5 = half durability loss, 0.0 = indestructible shields)&#x0a;• Higher = Shields break faster">
                                                <TextBlock Text="Shield Durability Loss" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayShieldDurabilityMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="PlayerActiveThirstMultiplier (ServerSettings.ini)&#x0a;Summary: Controls how fast players get thirsty while moving, fighting, or harvesting.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Get thirsty SLOWER (e.g. 0.5 = drink half as often, 0.0 = no active thirst)&#x0a;• Higher = Get thirsty faster">
                                                <TextBlock Text="Active Thirst" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayActiveThirstMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="PlayerIdleThirstMultiplier (ServerSettings.ini)&#x0a;Summary: Controls how fast players get thirsty while standing still / AFK in base.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Slower AFK thirst (e.g. 0.1 or 0.0 = prevents dying of thirst while AFK in base)">
                                                <TextBlock Text="Idle Thirst" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayIdleThirstMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" ToolTip="PlayerActiveHungerMultiplier (ServerSettings.ini)&#x0a;Summary: Controls how fast players get hungry while moving, fighting, or harvesting.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Get hungry SLOWER (e.g. 0.5 = eat half as often, 0.0 = no active hunger)&#x0a;• Higher = Get hungry faster">
                                                <TextBlock Text="Active Hunger" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayActiveHungerMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6" ToolTip="PlayerIdleHungerMultiplier (ServerSettings.ini)&#x0a;Summary: Controls how fast players get hungry while standing still / AFK in base.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Slower AFK hunger (e.g. 0.1 or 0.0 = prevents starving while AFK in base)">
                                                <TextBlock Text="Idle Hunger" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayIdleHungerMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassPanel}" Padding="10" Margin="2,6,2,2">
                                    <StackPanel>
                                        <TextBlock Text="🗡️ Player, NPC &amp; Thrall Damage Multipliers" Style="{StaticResource SectionHeading}" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="PlayerDamageMultiplier (ServerSettings.ini)&#x0a;Summary: Multiplies outgoing attack damage dealt directly by player characters.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = Players hit harder (e.g. 1.5 = +50% player damage, 2.0 = double damage)&#x0a;• Lower = Players deal less damage">
                                                <TextBlock Text="Player Damage Dealt Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayPlayerDmgMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="PlayerDamageTakenMultiplier (ServerSettings.ini)&#x0a;Summary: Multiplies incoming damage received by player characters from all attacks.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Players are tougher / take less damage (e.g. 0.5 = players take 50% less damage)&#x0a;• Higher = Deadlier combat for players (e.g. 1.5 = players take +50% damage)">
                                                <TextBlock Text="Player Damage Taken Mult" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayPlayerDmgTakenMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="NPCDamageMultiplier (ServerSettings.ini)&#x0a;Summary: Multiplies outgoing attack damage dealt by wild NPCs, monsters, and world bosses.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Lower = Easier enemies (e.g. 0.7 = monsters deal 30% less damage)&#x0a;• Higher = Harder enemies (e.g. 1.5 = monsters hit 50% harder)">
                                                <TextBlock Text="NPC / Monster Damage Dealt" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayNpcDmgMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="NPCDamageTakenMultiplier (ServerSettings.ini)&#x0a;Summary: Multiplies incoming damage received by wild NPCs, monsters, and world bosses.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• Higher = Bosses/NPCs die faster (e.g. 1.5 = enemies take +50% more damage; great for solo/duo play)&#x0a;• Lower = Tankier bosses (e.g. 0.7 = enemies take 30% less damage)">
                                                <TextBlock Text="NPC / Monster Damage Taken" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayNpcDmgTakenMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" ToolTip="ThrallDamageToPlayersMultiplier (ServerSettings.ini)&#x0a;Summary: Multiplies damage dealt by tamed Thrall &amp; Pet followers when attacking human players.&#x0a;Vanilla Default: 1.0&#x0a;Options &amp; Hints:&#x0a;• 1.0 = Standard thrall PvP damage&#x0a;• 0.5 = Reduces thrall dominance in player-vs-player fights">
                                                <TextBlock Text="Thrall Damage to Players" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayThrallDmgPlayersMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="1.0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" ToolTip="ThrallDamageToNPCsMultiplier (ServerSettings.ini)&#x0a;Summary: Multiplies damage dealt by tamed Thrall &amp; Pet followers when fighting wild NPCs and bosses.&#x0a;Vanilla Default: 0.5 (Official Age of War balance)&#x0a;Options &amp; Hints:&#x0a;• 0.5 = Official Funcom default&#x0a;• 1.0 = Restores pre-nerf full 100% Thrall PvE damage against bosses">
                                                <TextBlock Text="Thrall Damage to NPCs" Style="{StaticResource FormLabel}" FontSize="11"/>
                                                <TextBox x:Name="TxtGameplayThrallDmgNpcsMult" Style="{StaticResource FormInput}" FontSize="11" Padding="5,3" Text="0.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TOP-LEVEL TAB 3: LIVE WORLD MAP & PIPPI ADMIN (PORT 8089 + NATIVE CANVAS) -->
            <!-- ========================================================================= -->
            <TabItem Padding="14,5" FontSize="12" FontWeight="Bold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗺️ Live World Map &amp; Pippi Admin" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Action & Summary Bar -->
                    <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Margin="0,0,0,6" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🗺️ Live World Radar &amp; Pippi Admin Suite" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,12,0"/>
                                    <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0"
                                            ToolTip="Standalone Live World Map HTTP Server URL — Accessible from any browser on your PC, tablet, or phone!">
                                        <TextBlock x:Name="TxtLiveMapWebUrlBadge" Text="🌐 Webpage: http://localhost:8089" Foreground="#34D399" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock x:Name="TxtLiveMapStatsSummary" Text="Online: 0 | Total Characters: 0 | Clan Bases: 0 | Building Pieces: 0" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtLiveMapDbStatus" Text="Scans ConanSandbox/Saved/game.db (non-locking read-only mode) for player positions, clan bases, and building piece heatmaps." Foreground="#94A3B8" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnRefreshLiveMap" Content="🔄 Scan game.db &amp; Refresh Map" Style="{StaticResource BtnPrimary}" Padding="12,6" FontSize="11.5" FontWeight="Bold" Margin="0,0,6,0" Click="BtnRefreshLiveMap_Click"
                                        ToolTip="Immediately scan game.db for all player coordinates, clan bases, and building counts and redraw the map"/>
                                <Button x:Name="BtnOpenLiveMapWeb" Content="🌐 Open Live Map Webpage (:8089)" Style="{StaticResource BtnSuccess}" Padding="12,6" FontSize="11.5" FontWeight="Bold" Click="BtnOpenLiveMapWeb_Click"
                                        ToolTip="Open the interactive HTML5 Pan-and-Zoom Live World Map webpage on Port 8089 in your default web browser"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Split View: Left = Interactive World Map Canvas, Right = Bases / Players / Warps Tabs -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Interactive WPF World Map Radar Canvas -->
                        <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <ComboBox x:Name="CmbLiveMapWorldSelect" Width="170" Margin="0,0,10,0" SelectionChanged="CmbLiveMapWorldSelect_SelectionChanged"
                                                  ToolTip="Switch active map between The Exiled Lands and Isle of Siptah">
                                            <ComboBoxItem Content="🏜️ The Exiled Lands" Tag="exiled_lands" IsSelected="True"/>
                                            <ComboBoxItem Content="🏝️ Isle of Siptah" Tag="isle_of_siptah"/>
                                        </ComboBox>
                                        <CheckBox x:Name="ChkMapShowOnline" Content="🟢 Online Players" IsChecked="True" Style="{StaticResource FormCheck}" Margin="0,0,10,0" Checked="ChkMapFilter_Changed" Unchecked="ChkMapFilter_Changed"
                                                  ToolTip="Show or hide currently online players on the radar canvas"/>
                                        <CheckBox x:Name="ChkMapShowOffline" Content="⚪ Offline Bodies" IsChecked="True" Style="{StaticResource FormCheck}" Margin="0,0,10,0" Checked="ChkMapFilter_Changed" Unchecked="ChkMapFilter_Changed"
                                                  ToolTip="Show or hide offline / sleeping characters stored in game.db"/>
                                        <CheckBox x:Name="ChkMapShowBases" Content="🏰 Clan Bases" IsChecked="True" Style="{StaticResource FormCheck}" Margin="0,0,10,0" Checked="ChkMapFilter_Changed" Unchecked="ChkMapFilter_Changed"
                                                  ToolTip="Show or hide clan base clusters and building heatmaps on the radar canvas"/>
                                        <CheckBox x:Name="ChkMapShowWarps" Content="🔷 Public Warps" IsChecked="True" Style="{StaticResource FormCheck}" Margin="0,0,10,0" Checked="ChkMapFilter_Changed" Unchecked="ChkMapFilter_Changed"
                                                  ToolTip="Show or hide public server warps &amp; landmarks on the radar canvas"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnMapZoomOut" Content="➖" Width="26" Height="24" Padding="0" Margin="0,0,4,0" Style="{StaticResource BtnSecondary}" Click="BtnMapZoomOut_Click" ToolTip="Zoom Out"/>
                                        <TextBlock x:Name="TxtMapZoomLevel" Text="100%" Foreground="#E2E8F0" FontSize="11" FontWeight="Bold" Width="42" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnMapZoomIn" Content="➕" Width="26" Height="24" Padding="0" Margin="4,0,6,0" Style="{StaticResource BtnSecondary}" Click="BtnMapZoomIn_Click" ToolTip="Zoom In"/>
                                        <Button x:Name="BtnMapZoomReset" Content="🎯 Reset" Padding="6,2" Height="24" FontSize="11" Margin="0,0,10,0" Style="{StaticResource BtnSecondary}" Click="BtnMapZoomReset_Click" ToolTip="Reset Zoom &amp; Pan to 100% Center"/>
                                        <TextBlock x:Name="TxtMapHoverCoords" Text="Sector: -- | X: 0, Y: 0" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Map Radar Viewport -->
                                <Border Grid.Row="1" Background="#070D19" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Canvas x:Name="CnvLiveWorldMap" Background="#070D19" ClipToBounds="True"
                                            SizeChanged="CnvLiveWorldMap_SizeChanged"
                                            MouseMove="CnvLiveWorldMap_MouseMove"
                                            MouseLeftButtonDown="CnvLiveWorldMap_MouseLeftButtonDown"
                                            MouseLeftButtonUp="CnvLiveWorldMap_MouseLeftButtonUp"
                                            MouseRightButtonDown="CnvLiveWorldMap_MouseRightButtonDown"
                                            MouseRightButtonUp="CnvLiveWorldMap_MouseRightButtonUp"
                                            MouseWheel="CnvLiveWorldMap_MouseWheel"
                                            MouseLeave="CnvLiveWorldMap_MouseLeave"
                                            Cursor="Hand"
                                            ToolTip="Drag with mouse to pan. Use Mouse Wheel or buttons to zoom. Click any marker or location to copy TeleportPlayer coordinates!"/>
                                </Border>

                                <!-- Bottom Selected Target / Teleport Command Bar -->
                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtSelectedMapTeleportCmd" Style="{StaticResource FormInput}" IsReadOnly="True" FontSize="11" Text="TeleportPlayer 0 0 0" Margin="0,0,6,0"
                                             ToolTip="Unreal Engine Admin Teleport command for the selected Player, Clan Base, or Map click location"/>
                                    <Button Grid.Column="1" Content="📋 Copy TeleportPlayer" Style="{StaticResource BtnSecondary}" Padding="10,4" FontSize="11" Click="BtnCopySelectedTeleport_Click"
                                            ToolTip="Copy the TeleportPlayer X Y Z command to clipboard so you can paste it in the Conan ~ console"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Right Column: Pippi Admin & World Inspector Tabs -->
                        <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="6">
                            <TabControl Background="Transparent" BorderThickness="0">
                                <!-- Sub-Tab 1: Clan Bases & Building Heatmap Leaderboard -->
                                <TabItem Header="🏰 Clan Bases &amp; Pieces" Padding="8,4" FontSize="11" FontWeight="SemiBold">
                                    <Grid Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Clustered Clan &amp; Player Bases (Click a row to highlight &amp; generate TeleportPlayer command):" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                                        <ListBox Grid.Row="1" x:Name="LstWorldBases" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                                 SelectionChanged="LstWorldBases_SelectionChanged" FontFamily="Consolas" FontSize="11.5"/>
                                        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock Text="📊 Top Clan Building Piece Leaderboard (Lag / Bloat Audit)" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="TxtClanLeaderboardSummary" Text="No database scan run yet." Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <!-- Sub-Tab 2: Players, Ranks & Economy Wallets (Pippi Admin) -->
                                <TabItem Header="👥 Players, Ranks &amp; Wallets" Padding="8,4" FontSize="11" FontWeight="SemiBold">
                                    <Grid Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ListBox Grid.Row="0" x:Name="LstWorldPlayers" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                                 SelectionChanged="LstWorldPlayers_SelectionChanged" FontFamily="Consolas" FontSize="11.5"/>

                                        <!-- Pippi Rank & Wallet Editor -->
                                        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock Text="👑 Pippi Admin — Player Rank &amp; Currency Wallet Editor" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="0.9*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Character Name" Style="{StaticResource FormLabel}" FontSize="10.5"/>
                                                        <TextBox x:Name="TxtAdminEditPlayerName" Style="{StaticResource FormInput}" FontSize="11" Padding="4,3" IsReadOnly="True"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" ToolTip="Assign a Pippi-style permission rank (Admin, Moderator, VIP, Member)">
                                                        <TextBlock Text="Assigned Rank" Style="{StaticResource FormLabel}" FontSize="10.5"/>
                                                        <ComboBox x:Name="CmbAdminEditPlayerRank" Height="26" FontSize="11" SelectedIndex="3">
                                                            <ComboBoxItem Content="Admin"/>
                                                            <ComboBoxItem Content="Moderator"/>
                                                            <ComboBoxItem Content="VIP"/>
                                                            <ComboBoxItem Content="Member"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" ToolTip="Player's server currency wallet balance (Gold Coins)">
                                                        <TextBlock Text="Gold Wallet" Style="{StaticResource FormLabel}" FontSize="10.5"/>
                                                        <TextBox x:Name="TxtAdminEditPlayerWallet" Style="{StaticResource FormInput}" FontSize="11" Padding="4,3" Text="100"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="6" Content="💾 Save" Style="{StaticResource BtnSuccess}" VerticalAlignment="Bottom" Padding="10,4" FontSize="11" Click="BtnSavePlayerProfile_Click"
                                                            ToolTip="Save player's Rank and Gold Wallet balance to ceadmin_store.json"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <!-- Sub-Tab 3: Public Warps & Teleport Landmarks -->
                                <TabItem Header="📍 Public Warps" Padding="8,4" FontSize="11" FontWeight="SemiBold">
                                    <Grid Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ListBox Grid.Row="0" x:Name="LstWorldWarps" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                                 SelectionChanged="LstWorldWarps_SelectionChanged" FontFamily="Consolas" FontSize="11.5"/>

                                        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock Text="➕ Create / Manage Public Server Warps (Synced with Port 8089 Map &amp; Mod DataTables)" Foreground="#34D399" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Warp Name" Style="{StaticResource FormLabel}" FontSize="10.5"/>
                                                        <TextBox x:Name="TxtNewWarpName" Style="{StaticResource FormInput}" FontSize="11" Padding="4,3" Text="arena"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Unreal X" Style="{StaticResource FormLabel}" FontSize="10.5"/>
                                                        <TextBox x:Name="TxtNewWarpX" Style="{StaticResource FormInput}" FontSize="11" Padding="4,3" Text="-27850"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Unreal Y" Style="{StaticResource FormLabel}" FontSize="10.5"/>
                                                        <TextBox x:Name="TxtNewWarpY" Style="{StaticResource FormInput}" FontSize="11" Padding="4,3" Text="261200"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="6">
                                                        <TextBlock Text="Unreal Z" Style="{StaticResource FormLabel}" FontSize="10.5"/>
                                                        <TextBox x:Name="TxtNewWarpZ" Style="{StaticResource FormInput}" FontSize="11" Padding="4,3" Text="0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="8" Content="➕ Add" Style="{StaticResource BtnSuccess}" VerticalAlignment="Bottom" Padding="8,4" FontSize="11" Click="BtnAddWarp_Click"/>
                                                    <Button Grid.Column="10" Content="🗑️" Style="{StaticResource BtnDanger}" VerticalAlignment="Bottom" Padding="8,4" FontSize="11" Click="BtnDeleteWarp_Click" ToolTip="Delete selected warp"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Row 2: RCON Input Bar -->
        <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Margin="2,2,2,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="TxtRconCmd" Style="{StaticResource FormInput}" 
                         ToolTip="Enter RCON command (e.g. broadcast Maintenance in 5 minutes! or save)"/>
                <Button Grid.Column="2" Content="Send RCON" Style="{StaticResource BtnPrimary}" Click="BtnSendRcon_Click"/>
            </Grid>
        </Border>

        <!-- Row 3: System Metrics & Multi-Tier Uptime Status Bar -->
        <Border Grid.Row="3" Style="{StaticResource GlassPanel}" Margin="2,1,2,2" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Multi-Tier Uptimes -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Conan Server Process Uptime -->
                    <Border CornerRadius="6" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="8,3" Margin="0,0,8,0"
                            ToolTip="True Conan Sandbox Server Process Uptime (Tracks the actual ConanSandboxServer-Win64-Shipping.exe process lifetime)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱️ Server Uptime:" Foreground="#94A3B8" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtStatusServerUptime" Text="00:00:00" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Server Manager Application Uptime -->
                    <Border CornerRadius="6" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="8,3" Margin="0,0,8,0"
                            ToolTip="Server Manager Application Uptime (Tracks how long ConanServerManager.exe has been running)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕒 App Uptime:" Foreground="#94A3B8" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtStatusAppUptime" Text="00:00:00" Foreground="#A78BFA" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Windows Host OS Uptime -->
                    <Border CornerRadius="6" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="8,3" Margin="0,0,8,0"
                            ToolTip="Windows Host Operating System Uptime (Elapsed time since host machine was booted)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻 Windows Host:" Foreground="#94A3B8" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtStatusSystemUptime" Text="00:00:00" Foreground="#34D399" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Right: Dedicated RAM Metrics -->
                <Border Grid.Column="1" CornerRadius="6" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="8,3" VerticalAlignment="Center"
                        ToolTip="Live RAM Usage: Conan Server Process Working Set | Manager App Working Set | Total Windows Host Physical RAM">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧠 RAM Usage:" Foreground="#94A3B8" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtStatusRamUsage" Text="Conan: -- MB | App: -- MB | System: -- / -- GB (--%)" Foreground="#FBBF24" FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Full-Page Steam Workshop Browser Overlay (Spans entire application window) -->
        <Grid x:Name="PnlFullPageBrowser" Grid.Row="0" Grid.RowSpan="4" Background="#0F172A" Visibility="Collapsed" Panel.ZIndex="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Navigation Bar -->
                <RowDefinition Height="Auto"/> <!-- Smart Mod Detection Banner -->
                <RowDefinition Height="*"/>    <!-- Full-Screen Chromium WebView2 -->
            </Grid.RowDefinitions>

            <!-- Top Navigation Bar -->
            <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Back / Return to Dashboard button -->
                        <ColumnDefinition Width="Auto"/> <!-- Browser Nav Controls -->
                        <ColumnDefinition Width="*"/>    <!-- Address Bar -->
                        <ColumnDefinition Width="Auto"/> <!-- Go Button -->
                        <ColumnDefinition Width="Auto"/> <!-- Search Bar -->
                    </Grid.ColumnDefinitions>

                    <!-- Back to Server Manager button -->
                    <Button Grid.Column="0" Content="◀ Back to Server Manager" Style="{StaticResource BtnPrimary}" Click="BtnCloseFullPageBrowser_Click" Margin="0,0,12,0" Padding="14,6" FontWeight="Bold" ToolTip="Close browser and return to server manager dashboard (or press Esc)"/>

                    <!-- Nav Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button x:Name="BtnBrowserBack" Content="◀" Style="{StaticResource BtnSecondary}" Width="36" Height="32" Padding="0" Click="BtnBrowserBack_Click" ToolTip="Go Back" Margin="0,0,4,0"/>
                        <Button x:Name="BtnBrowserForward" Content="▶" Style="{StaticResource BtnSecondary}" Width="36" Height="32" Padding="0" Click="BtnBrowserForward_Click" ToolTip="Go Forward" Margin="0,0,4,0"/>
                        <Button x:Name="BtnBrowserRefresh" Content="🔄" Style="{StaticResource BtnSecondary}" Width="36" Height="32" Padding="0" Click="BtnBrowserRefresh_Click" ToolTip="Reload" Margin="0,0,6,0"/>
                        <Button x:Name="BtnBrowserHome" Content="🏠 Workshop Home" Style="{StaticResource BtnSecondary}" Height="32" Padding="12,4" Click="BtnBrowserHome_Click" ToolTip="Go to Conan Exiles Steam Workshop Hub" Margin="0,0,4,0"/>
                    </StackPanel>

                    <!-- Address Bar -->
                    <TextBox Grid.Column="2" x:Name="TxtBrowserUrl" Style="{StaticResource FormInput}" Height="32" VerticalContentAlignment="Center" Margin="0,0,6,0" KeyDown="TxtBrowserUrl_KeyDown" ToolTip="Enter URL or Workshop Mod ID and press Enter"/>
                    <Button Grid.Column="3" x:Name="BtnBrowserGo" Content="Go" Style="{StaticResource BtnSecondary}" Height="32" Padding="14,4" Click="BtnBrowserGo_Click" Margin="0,0,12,0"/>

                    <!-- Search Input -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <TextBox x:Name="TxtBrowserSearchQuery" Style="{StaticResource FormInput}" Width="220" Height="32" VerticalContentAlignment="Center" Margin="0,0,4,0" KeyDown="TxtBrowserSearchQuery_KeyDown" ToolTip="Search Conan Exiles Steam Workshop"/>
                        <Button x:Name="BtnBrowserSearch" Content="🔍 Search Mods" Style="{StaticResource BtnPrimary}" Height="32" Padding="14,4" Click="BtnBrowserSearch_Click" ToolTip="Search Conan Exiles Workshop"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Smart Mod Detection Banner -->
            <Border Grid.Row="1" x:Name="PnlBrowserModBanner" Visibility="Collapsed" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="🧩" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Workshop Mod Detected:" Foreground="#A5B4FC" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBrowserModId" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock x:Name="TxtBrowserModStatus" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnAddBrowserModToServer" Content="➕ Add This Mod to Server" Style="{StaticResource BtnSuccess}" Click="BtnAddBrowserModToServer_Click" Padding="16,6" FontWeight="Bold" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRemoveBrowserModFromServer" Content="🗑️ Remove from Server" Style="{StaticResource BtnDanger}" Visibility="Collapsed" Click="BtnRemoveBrowserModFromServer_Click" Padding="16,6" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Full-Page Chromium WebView2 -->
            <Grid Grid.Row="2">
                <wv2:WebView2 x:Name="WvModBrowser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Fallback error panel if WebView2 runtime is missing -->
                <Border x:Name="PnlWebView2Error" Visibility="Collapsed" Background="#0F172A" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10" BorderBrush="#EF4444" BorderThickness="1">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Center">
                        <TextBlock Text="⚠️ WebView2 Runtime Required" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,10" TextAlignment="Center"/>
                        <TextBlock Text="The in-app browser uses Microsoft Edge WebView2. It could not be initialized (the runtime may not be installed on this Windows system)." TextWrapping="Wrap" Foreground="#94A3B8" Margin="0,0,0,18" TextAlignment="Center" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="🔄 Retry In-App Browser" Style="{StaticResource BtnSecondary}" Click="BtnRetryWebView2_Click" Margin="0,0,10,0" Padding="14,6"/>
                            <Button Content="📥 Download WebView2" Style="{StaticResource BtnPrimary}" Click="BtnDownloadWebView2_Click" Margin="0,0,10,0" Padding="14,6"/>
                            <Button Content="🌐 Open Workshop in External Browser" Style="{StaticResource BtnSecondary}" Click="BtnOpenWorkshopExternal_Click" Padding="14,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
